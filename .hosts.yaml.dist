# **Which boxes this installation deploys to** (XIV-61, §4.8).
#
# Copy to `.hosts.yaml` and fill in. That file is gitignored on purpose: this
# ticket decided the deploy definition must not bake in a provider, because the
# German test box is a rehearsal for the move to a Swiss one, and a move that
# means editing a committed file is a move somebody does wrong under pressure.
#
# `deploy.php` is written for two instances and not for one host. The public one
# faces customers and is built without the administration surface; the internal
# one has it and XIV-60 requires it not be publicly reachable, which on a single
# box means a private interface or a VPN rather than a different port.
hosts:
  public:
    hostname: 198.51.100.10
    remote_user: root
    labels:
      instance: public
    # The customer-facing build (XIV-96, §4.4).
    docker_target: frankenphp_public

  # Uncomment when the control instance exists. Whether it is a second box or a
  # second stack on the first is still open on XIV-61; if it is a second stack,
  # this entry points at the same hostname with a different deploy_path.
  #
  # internal:
  #   hostname: 10.0.0.5
  #   remote_user: root
  #   deploy_path: /opt/xivi-internal
  #   labels:
  #     instance: internal
  #   docker_target: frankenphp_prod
