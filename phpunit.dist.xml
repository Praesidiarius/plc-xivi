<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <!--
            The functional tests keep one kernel across a whole class, so the
            profiler's per-request data piles up over a few dozen browser
            requests. Not a leak to chase: it is what disabling the reboot buys
            in speed, paid for in memory.
        -->
        <ini name="memory_limit" value="512M" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <!--
            Everything except the browser tests, named directory by directory
            rather than by excluding one — `<exclude>` inside a suite is quietly
            ignored here. Both runners are told which suite to run as well, since
            paratest takes every suite it can find otherwise, and a browser test
            started eight times over is not a subtle failure. They cannot run in
            parallel:
            Panther starts one web server on one port per process, and eight
            paratest workers would fight over it (XIV-31).
        -->
        <testsuite name="Project Test Suite">
            <directory>tests/Unit</directory>
            <directory>tests/Functional</directory>
            <!-- One test lives beside the trait it is about. -->
            <directory>tests/Support</directory>
        </testsuite>

        <!--
            The safety net: a real browser, a handful of assertions, run in one
            process by `composer test:browser`. Deliberately few — an end-to-end
            layer is where flakiness lives, and a flaky net gets skipped.
        -->
        <testsuite name="browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
            <!-- The engine lives here, so leaving it out would have measured the
                 application's wiring and called it the project's coverage. One
                 line per module, since PHPUnit does not glob these. -->
            <!-- The administration surface, which was measured as part of src/
                 until it became a package (XIV-60). Leaving it out would have
                 dropped provisioning, the operator firewall and the tenant list
                 out of the coverage figure without dropping a single test. -->
            <directory>packages/control-plane/src</directory>
            <directory>packages/core/src</directory>
            <directory>packages/contact/src</directory>
            <directory>packages/article/src</directory>
            <directory>packages/order/src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
        <!--
            Panther's own extension owns the lifecycle of the web server the
            browser tests talk to (XIV-31): started once, stopped when the run
            ends. A run that is killed can still leave it holding port 9080, and
            the symptom then is a timeout that says nothing about a stray
            process — `docker compose restart php` is the cure.
        -->
        <bootstrap class="Symfony\Component\Panther\ServerExtension" />
        <!-- Opens a transaction on the tenant connection before each test and
             rolls it back afterwards. See config/packages/test/dama_doctrine_test.yaml. -->
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>
</phpunit>
