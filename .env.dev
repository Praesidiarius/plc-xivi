
###> symfony/framework-bundle ###
APP_SECRET=dev-only-not-a-real-secret
###< symfony/framework-bundle ###

# Mail sent in development goes to the catcher, where it can be read (XIV-41).
# `mailpit` is a compose service, so this DSN only resolves inside the stack —
# see compose.override.yaml, and the README for the address to open.
#
# Unauthenticated and unencrypted, which is right for a container on a private
# network that accepts everything and delivers nothing.
MAILER_DSN=smtp://mailpit:1025
