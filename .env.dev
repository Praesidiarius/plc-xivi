
###> symfony/framework-bundle ###
APP_SECRET=dev-only-not-a-real-secret
###< symfony/framework-bundle ###

# Mail sent in development goes to the catcher, where it can be read (XIV-41).
# `mailpit` is a compose service, so this DSN only resolves inside the stack —
# see compose.override.yaml, and the README for the address to open.
#
# Unauthenticated and unencrypted, which is right for a container on a private
# network that accepts everything and delivers nothing.
MAILER_DSN=smtp://mailpit:1025

# Self-service signup, switched on so a developer can exercise it (XIV-64).
# `.localhost` resolves to the loopback in every browser with no hosts file, the
# same trick CONTROL_PLANE_HOST uses, so `https://signup.localhost/` works in a
# fresh checkout. The secret is a development value and is in a committed file on
# purpose — the endpoint it guards writes a row and sends mail to the catcher.
SIGNUP_HOST=signup.localhost
XIVI_SIGNUP_SECRET=dev-only-signup-secret-not-a-real-one
