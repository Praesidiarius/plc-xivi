{% extends 'base.html.twig' %}

{% block title %}Permission groups{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">Permission groups</h1>
			<div class="d-flex gap-2">
				<a class="btn btn-outline-secondary" href="{{ path('user_index') }}">
					<i class="bi bi-people" aria-hidden="true"></i> Users
				</a>
				<a class="btn btn-primary" href="{{ path('group_new') }}">
					<i class="bi bi-plus-lg" aria-hidden="true"></i> New group
				</a>
			</div>
		</div>

		<p class="text-body-secondary">
			A group is a set of permissions given to a job rather than to a person, so it
			survives somebody leaving it. Everything is additive: a user has whatever all
			their groups give them, and nothing here can take a permission away.
		</p>

		{% if groups is empty %}
			{#
				Not a failure state. Until somebody makes a group, only administrators
				can do anything — which is a working installation, just a small one.
			#}
			<div class="card">
				<div class="card-body text-center py-5">
					<i class="bi bi-shield-lock display-4 text-body-secondary" aria-hidden="true"></i>
					<h2 class="h5 mt-3">No groups yet</h2>
					<p class="text-body-secondary mb-4">
						Administrators can already do everything. Everybody else can do nothing
						until a group says otherwise.
					</p>
					<a class="btn btn-primary" href="{{ path('group_new') }}">
						<i class="bi bi-plus-lg" aria-hidden="true"></i> Make the first one
					</a>
				</div>
			</div>
		{% else %}
			<div class="table-responsive">
				<table class="table align-middle">
					<thead>
						<tr>
							<th scope="col">Group</th>
							<th scope="col">Members</th>
							<th scope="col">Permissions</th>
							<th scope="col"><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						{% for group in groups %}
							<tr>
								<td>
									<a class="text-reset" href="{{ path('group_edit', {id: group.id}) }}">{{ group.label }}</a>
								</td>
								<td class="text-body-secondary">{{ group.members|length }}</td>
								<td class="text-body-secondary">{{ group.grants|length }}</td>
								<td class="text-end">
									<a class="btn btn-sm btn-outline-secondary" href="{{ path('group_edit', {id: group.id}) }}">
										<i class="bi bi-pencil" aria-hidden="true"></i>
										<span class="visually-hidden">Edit {{ group.label }}</span>
									</a>
									<a class="btn btn-sm btn-outline-danger" href="{{ path('group_confirm_delete', {id: group.id}) }}">
										<i class="bi bi-trash" aria-hidden="true"></i>
										<span class="visually-hidden">Delete {{ group.label }}</span>
									</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</main>
{% endblock %}
