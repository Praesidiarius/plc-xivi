{% extends 'base.html.twig' %}

{% block title %}Permission groups{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ 'group.title'|trans }}</h1>
			<div class="d-flex gap-2">
				<a class="btn btn-outline-secondary" href="{{ path('user_index') }}">
					<i class="bi bi-people" aria-hidden="true"></i> {{ 'nav.users'|trans }}
				</a>
				<a class="btn btn-primary" href="{{ path('group_new') }}">
					<i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'group.new'|trans }}
				</a>
			</div>
		</div>

		<p class="text-body-secondary">
			{{ 'group.intro'|trans }}
		</p>

		{% if groups is empty %}
			{#
				Not a failure state. Until somebody makes a group, only administrators
				can do anything — which is a working installation, just a small one.
			#}
			<div class="card">
				<div class="card-body text-center py-5">
					<i class="bi bi-shield-lock display-4 text-body-secondary" aria-hidden="true"></i>
					<h2 class="h5 mt-3">{{ 'group.empty_title'|trans }}</h2>
					<p class="text-body-secondary mb-4">
						{{ 'group.empty_body'|trans }}
					</p>
					<a class="btn btn-primary" href="{{ path('group_new') }}">
						<i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'group.make_first'|trans }}
					</a>
				</div>
			</div>
		{% else %}
			<div class="table-responsive">
				<table class="table align-middle">
					<thead>
						<tr>
							<th scope="col">{{ 'group.one'|trans }}</th>
							<th scope="col">{{ 'group.members'|trans }}</th>
							<th scope="col">{{ 'group.permissions'|trans }}</th>
							<th scope="col"><span class="visually-hidden">{{ 'common.actions'|trans }}</span></th>
						</tr>
					</thead>
					<tbody>
						{% for group in groups %}
							<tr>
								<td>
									<a class="text-reset" href="{{ path('group_edit', {id: group.id}) }}">{{ group.label }}</a>
								</td>
								<td class="text-body-secondary">{{ group.members|length }}</td>
								<td class="text-body-secondary">{{ group.grants|length }}</td>
								<td class="text-end">
									<a class="btn btn-sm btn-outline-secondary" href="{{ path('group_edit', {id: group.id}) }}"
									   data-bs-toggle="tooltip" title="{{ 'group.tooltip_edit'|trans }}">
										<i class="bi bi-pencil" aria-hidden="true"></i>
										<span class="visually-hidden">{{ 'group.edit_aria'|trans({'%group%': group.label}) }}</span>
									</a>
									<a class="btn btn-sm btn-outline-danger" href="{{ path('group_confirm_delete', {id: group.id}) }}"
									   data-bs-toggle="tooltip" title="{{ 'group.tooltip_delete'|trans }}">
										<i class="bi bi-trash" aria-hidden="true"></i>
										<span class="visually-hidden">{{ 'group.delete_aria'|trans({'%group%': group.label}) }}</span>
									</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</main>
{% endblock %}
