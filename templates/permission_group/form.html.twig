{% extends 'base.html.twig' %}

{% block title %}{{ group.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ group.label }}</h1>
			<a class="btn btn-link" href="{{ path('group_index') }}">{{ 'common.back'|trans }}</a>
		</div>

		<form method="post">
			<input type="hidden" name="_token" value="{{ csrf_token('manage-groups') }}">

			<div class="card mb-4">
				<div class="card-body">
					<label class="form-label" for="label">{{ 'common.name'|trans }}</label>
					<input class="form-control" id="label" name="label" required value="{{ group.label }}">
				</div>
			</div>

			<h2 class="h5 mb-2">{{ 'group.what_it_may_do'|trans }}</h2>
			<p class="text-body-secondary">
				{{ 'group.matrix_help'|trans|raw }}
			</p>

			{% if modules is empty %}
				<div class="alert alert-secondary">
					{{ 'group.no_modules'|trans }}
				</div>
			{% else %}
				<div class="card mb-4">
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead>
								<tr>
									<th scope="col" class="text-body-secondary small text-uppercase">{{ 'common.module'|trans }}</th>
									{% for action in actions %}
										<th scope="col" class="text-body-secondary small text-uppercase">{{ action.labelKey|trans({}, 'xivi') }}</th>
									{% endfor %}
								</tr>
							</thead>
							<tbody>
								{% for module in modules %}
									<tr>
										<th scope="row" class="fw-normal">
											<i class="bi bi-{{ module.icon }} text-body-secondary" aria-hidden="true"></i>
											{{ module.label }}
										</th>
										{% for action in actions %}
											{% set current = matrix[module.key][action.value]|default('') %}
											<td>
												{#
													A select rather than a checkbox even where there are only
													two answers, so a row reads as one kind of control all the
													way across. Non-scopable actions simply offer fewer options
													— "add, but only your own" describes nothing.
												#}
												<select class="form-select form-select-sm"
												        name="grants[{{ module.key }}][{{ action.value }}]"
												        aria-label="{{ action.labelKey|trans({}, 'xivi') }} {{ module.label }}">
													<option value="">{{ 'permission.no'|trans }}</option>
													{% for scope in scopes %}
														{% if action.isScopable or scope.value == 'all' %}
															<option value="{{ scope.value }}" {{ current == scope.value ? 'selected' : '' }}>
																{{ action.isScopable ? scope.labelKey|trans({}, 'xivi') : 'permission.yes'|trans }}
															</option>
														{% endif %}
													{% endfor %}
												</select>
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endif %}

			{#
				The parts of the instance that are not a module's records (XIV-12). Its
				own table rather than rows in the one above: an area answers a couple of
				the verbs and none of the scope question — there is one profile and it is
				nobody's own — so the columns are simply different.
			#}
			<h2 class="h5 mb-2">{{ 'group.instance'|trans }}</h2>
			<p class="text-body-secondary">{{ 'group.instance_help'|trans }}</p>

			<div class="card mb-4">
				<div class="table-responsive">
					<table class="table align-middle mb-0">
						<thead>
							<tr>
								<th scope="col" class="text-body-secondary small text-uppercase">{{ 'common.area'|trans }}</th>
								{% for action in actions %}
									<th scope="col" class="text-body-secondary small text-uppercase">{{ action.labelKey|trans({}, 'xivi') }}</th>
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for area in areas %}
								<tr>
									<th scope="row" class="fw-normal">
										<i class="bi bi-{{ area.icon }} text-body-secondary" aria-hidden="true"></i>
										{{ area.labelKey|trans }}
									</th>
									{% for action in actions %}
										<td>
											{% if area.allows(action) %}
												<select class="form-select form-select-sm"
												        name="grants[{{ area.value }}][{{ action.value }}]"
												        aria-label="{{ action.labelKey|trans({}, 'xivi') }} {{ area.labelKey|trans }}">
													<option value="">{{ 'permission.no'|trans }}</option>
													<option value="all" {{ matrix[area.value][action.value]|default('') ? 'selected' : '' }}>
														{{ 'permission.yes'|trans }}
													</option>
												</select>
											{% endif %}
										</td>
									{% endfor %}
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			{#
				The store, which is the second permission axis rather than a third
				table of the same kind (§8.4.3, XIV-6). Its own section because its
				*verbs* are its own: browse and install are not things done to a
				module's records, so they share no column with the matrix above and
				drawing them into it would have meant a grid mostly full of cells that
				mean nothing.

				Yes or no, with no scope: a module this customer has not installed has
				no records for "only my own" to be about.
			#}
			<h2 class="h5 mb-2">{{ 'group.store'|trans }}</h2>
			<p class="text-body-secondary">{{ 'group.store_help'|trans }}</p>

			<div class="card mb-4">
				<ul class="list-group list-group-flush">
					{% for action in storeActions %}
						<li class="list-group-item d-flex align-items-center justify-content-between gap-3">
							<label class="form-label mb-0" for="store-{{ action.value }}">
								<i class="bi bi-{{ action.icon }} text-body-secondary" aria-hidden="true"></i>
								{{ action.labelKey|trans }}
								<span class="d-block text-body-secondary small">{{ ('permission.store.' ~ action.value ~ '_help')|trans }}</span>
							</label>
							<select class="form-select form-select-sm w-auto"
							        id="store-{{ action.value }}"
							        name="grants[{{ store }}][{{ action.value }}]"
							        aria-label="{{ action.labelKey|trans }}">
								<option value="">{{ 'permission.no'|trans }}</option>
								<option value="all" {{ matrix[store][action.value]|default('') ? 'selected' : '' }}>
									{{ 'permission.yes'|trans }}
								</option>
							</select>
						</li>
					{% endfor %}
				</ul>
			</div>

			<h2 class="h5 mb-2">{{ 'group.who_is_in_it'|trans }}</h2>
			<p class="text-body-secondary">
				{{ 'group.members_help'|trans }}
			</p>

			<div class="card mb-4">
				<div class="card-body">
					{% set members_available = users|filter(u => 'ROLE_ADMIN' not in u.roles) %}
					{% for user in members_available %}
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="member-{{ user.id }}"
							       name="members[{{ user.id }}]" value="{{ user.id }}"
							       {{ user.id in members ? 'checked' : '' }}>
							<label class="form-check-label" for="member-{{ user.id }}">
								{{ user.name }}
								<span class="text-body-secondary">{{ user.email }}</span>
								{% if not user.active %}
									<span class="badge text-bg-secondary">{{ 'user.deactivated'|trans }}</span>
								{% endif %}
							</label>
						</div>
					{% endfor %}

					{% if members_available is empty %}
						<p class="text-body-secondary mb-0">
							{{ 'group.no_members_available'|trans }}
						</p>
					{% endif %}
				</div>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
				<a class="btn btn-link" href="{{ path('group_index') }}">{{ 'common.cancel'|trans }}</a>
			</div>
		</form>
	</main>
{% endblock %}
