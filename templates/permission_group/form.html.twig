{% extends 'base.html.twig' %}

{% block title %}{{ group.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ group.label }}</h1>
			<a class="btn btn-link" href="{{ path('group_index') }}">Back</a>
		</div>

		<form method="post">
			<input type="hidden" name="_token" value="{{ csrf_token('manage-groups') }}">

			<div class="card mb-4">
				<div class="card-body">
					<label class="form-label" for="label">Name</label>
					<input class="form-control" id="label" name="label" required value="{{ group.label }}">
				</div>
			</div>

			<h2 class="h5 mb-2">What this group may do</h2>
			<p class="text-body-secondary">
				One row per module this customer has, one column per action.
				<strong>Own records</strong> means only the ones that person created —
				it applies to the actions that name a record which already exists, so
				adding and importing are all-or-nothing.
			</p>

			{% if modules is empty %}
				<div class="alert alert-secondary">
					No modules are installed, so there is nothing to grant yet.
				</div>
			{% else %}
				<div class="card mb-4">
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead>
								<tr>
									<th scope="col" class="text-body-secondary small text-uppercase">Module</th>
									{% for action in actions %}
										<th scope="col" class="text-body-secondary small text-uppercase">{{ action.label }}</th>
									{% endfor %}
								</tr>
							</thead>
							<tbody>
								{% for module in modules %}
									<tr>
										<th scope="row" class="fw-normal">
											<i class="bi bi-{{ module.icon }} text-body-secondary" aria-hidden="true"></i>
											{{ module.label }}
										</th>
										{% for action in actions %}
											{% set current = matrix[module.key][action.value]|default('') %}
											<td>
												{#
													A select rather than a checkbox even where there are only
													two answers, so a row reads as one kind of control all the
													way across. Non-scopable actions simply offer fewer options
													— "add, but only your own" describes nothing.
												#}
												<select class="form-select form-select-sm"
												        name="grants[{{ module.key }}][{{ action.value }}]"
												        aria-label="{{ action.label }} {{ module.label }}">
													<option value="">No</option>
													{% for scope in scopes %}
														{% if action.isScopable or scope.value == 'all' %}
															<option value="{{ scope.value }}" {{ current == scope.value ? 'selected' : '' }}>
																{{ action.isScopable ? scope.label : 'Yes' }}
															</option>
														{% endif %}
													{% endfor %}
												</select>
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endif %}

			<h2 class="h5 mb-2">Who is in it</h2>
			<p class="text-body-secondary">
				Administrators are not listed: they may already do everything, and putting
				one in a group would suggest it could be taken away again.
			</p>

			<div class="card mb-4">
				<div class="card-body">
					{% set members_available = users|filter(u => 'ROLE_ADMIN' not in u.roles) %}
					{% for user in members_available %}
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="member-{{ user.id }}"
							       name="members[{{ user.id }}]" value="{{ user.id }}"
							       {{ user.id in members ? 'checked' : '' }}>
							<label class="form-check-label" for="member-{{ user.id }}">
								{{ user.name }}
								<span class="text-body-secondary">{{ user.email }}</span>
								{% if not user.active %}
									<span class="badge text-bg-secondary">Deactivated</span>
								{% endif %}
							</label>
						</div>
					{% endfor %}

					{% if members_available is empty %}
						<p class="text-body-secondary mb-0">
							Everybody here is an administrator, so there is nobody to add yet.
						</p>
					{% endif %}
				</div>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary">Save</button>
				<a class="btn btn-link" href="{{ path('group_index') }}">Cancel</a>
			</div>
		</form>
	</main>
{% endblock %}
