{% extends 'base.html.twig' %}

{% block title %}{{ 'group.delete_title'|trans({'%group%': group.label}) }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell" style="max-width: 36rem;">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">{{ 'group.delete_heading'|trans({'%group%': group.label}) }}</h1>

		{#
			The numbers are the point. Somebody deleting a group is deciding for
			everybody in it, and how many that is turns an abstract click into an
			obvious answer either way (§5.4 makes the same argument about removing a
			field).
		#}
		<div class="alert alert-warning">
			{{ 'group.delete_members'|trans({'%count%': members}) }}
			{{ 'group.delete_grants'|trans({'%count%': grants}) }}
			{% if members > 0 %}
				{{ 'group.delete_warning'|trans }}
			{% endif %}
		</div>

		<p class="text-body-secondary">
			{{ 'group.delete_note'|trans }}
		</p>

		<form method="post" action="{{ path('group_delete', {id: group.id}) }}" class="d-flex gap-2">
			<input type="hidden" name="_token" value="{{ csrf_token('manage-groups') }}">
			<button type="submit" class="btn btn-danger">{{ 'group.delete_confirm'|trans }}</button>
			<a class="btn btn-link" href="{{ path('group_index') }}">{{ 'common.cancel'|trans }}</a>
		</form>
	</main>
{% endblock %}
