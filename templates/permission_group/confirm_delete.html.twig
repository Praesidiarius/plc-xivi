{% extends 'base.html.twig' %}

{% block title %}Delete {{ group.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell" style="max-width: 36rem;">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">Delete “{{ group.label }}”?</h1>

		{#
			The numbers are the point. Somebody deleting a group is deciding for
			everybody in it, and how many that is turns an abstract click into an
			obvious answer either way (§5.4 makes the same argument about removing a
			field).
		#}
		<div class="alert alert-warning">
			{{ members }} {{ members == 1 ? 'person' : 'people' }}
			{{ members == 1 ? 'is' : 'are' }} in this group, and it grants
			{{ grants }} permission{{ grants == 1 ? '' : 's' }}.
			{% if members > 0 %}
				They lose what it gave them, unless another group gives them the same.
			{% endif %}
		</div>

		<p class="text-body-secondary">
			Nobody is deleted and nothing they own is touched — only the group and what
			it granted. It cannot be undone, but it can be made again.
		</p>

		<form method="post" action="{{ path('group_delete', {id: group.id}) }}" class="d-flex gap-2">
			<input type="hidden" name="_token" value="{{ csrf_token('manage-groups') }}">
			<button type="submit" class="btn btn-danger">Delete the group</button>
			<a class="btn btn-link" href="{{ path('group_index') }}">Cancel</a>
		</form>
	</main>
{% endblock %}
