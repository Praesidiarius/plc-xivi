{% extends 'base.html.twig' %}

{% block title %}Remove {{ field.label }} — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">{{ 'field.remove_title'|trans({'%field%': field.label}) }}</h1>

		<div class="card">
			<div class="card-body">
				{# The whole reason this page exists: somebody clicking Remove reasonably
				   assumes the data goes too. It does not, and saying so afterwards would
				   be too late (§5.4). #}
				<p>
					{{ 'field.remove_body'|trans({'%key%': field.key})|raw }}
				</p>

				<p class="mb-0">
					{% if holding == 0 %}
						{{ 'field.remove_none_hold'|trans }}
					{% else %}
						{{ 'field.remove_holding'|trans({'%count%': holding})|raw }}
					{% endif %}
				</p>

				<p class="text-body-secondary small mt-3 mb-0">
					{{ 'field.remove_note'|trans }}
				</p>
			</div>
		</div>

		<div class="d-flex align-items-center gap-2 mt-3">
			<a class="btn btn-link" href="{{ path('field_edit', {module: module.key, field: field.id}) }}">{{ 'common.cancel'|trans }}</a>
			<form method="post" action="{{ path('field_delete', {module: module.key, field: field.id}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('edit-fields') }}">
				<button class="btn btn-danger" type="submit">{{ 'field.remove_confirm'|trans }}</button>
			</form>
		</div>
	</main>
{% endblock %}
