{#
	The controls this type declares, and no others ([XIV-163]).

	`options` is the list the controller derived from the type's own capability
	declarations ({@see App\Controller\FieldController::drawnFor}), so what is
	drawn here is decided by the type rather than by this file. Adding an option
	to a type is still what §5.4 says it is: an interface, a line in the editor's
	per-type list, and one block below. What is no longer needed is a rule about
	when to hide it, because a form for one type only ever contains what that
	type has.

	Shared by the add form and the per-field form because "what controls does
	this type have" has one answer, and two templates asking it separately is how
	the two would come to disagree, which is the drift this ticket deleted the
	combined form to avoid.

	`field` is the definition being edited, or null while one is being added.
	Almost every block reads it only for the value to put in the box; the two
	that read more say why.
#}
{% if 'max_length' in options %}
	{#
		How much text (XIV-163). Blank is the ordinary answer: the type has a
		default and goes on following it, which is why an empty box is not a zero.
	#}
	<div class="col-sm-4">
		<label class="form-label small mb-1" for="opt_max_length">{{ 'field.max_length'|trans }}</label>
		<input id="opt_max_length" type="number" min="1" step="1" class="form-control form-control-sm"
		       name="max_length" value="{{ field ? field.getOption('max_length', '') : '' }}"
		       placeholder="{{ 'field.max_length_default'|trans }}">
	</div>
{% endif %}

{% if 'min' in options or 'max' in options %}
	{#
		How small and how large (XIV-163). Two boxes and one idea, which is why
		one capability declares both: no type has ever wanted a floor without a
		ceiling. Either may be left empty, and almost every field leaves both.
	#}
	<div class="col-sm-3">
		<label class="form-label small mb-1" for="opt_min">{{ 'field.min'|trans }}</label>
		<input id="opt_min" type="number" step="1" class="form-control form-control-sm"
		       name="min" value="{{ field ? field.getOption('min', '') : '' }}"
		       placeholder="{{ 'field.bound_none'|trans }}">
	</div>
	<div class="col-sm-3">
		<label class="form-label small mb-1" for="opt_max">{{ 'field.max'|trans }}</label>
		<input id="opt_max" type="number" step="1" class="form-control form-control-sm"
		       name="max" value="{{ field ? field.getOption('max', '') : '' }}"
		       placeholder="{{ 'field.bound_none'|trans }}">
	</div>
{% endif %}

{% if 'autocomplete' in options %}
	{#
		Whether somebody types to narrow this field, or scrolls it (XIV-36). Blank
		is the useful answer for almost every field: the engine knows how many
		candidates there are and decides, so a contact list that grows past a
		dropdown's worth turns into a search box without anybody having to find
		this setting.
	#}
	<div class="col-sm-4">
		<label class="form-label small mb-1" for="opt_autocomplete">{{ 'field.autocomplete'|trans }}</label>
		<select id="opt_autocomplete" class="form-select form-select-sm" name="autocomplete">
			{% for value, label in autocompleteChoices %}
				<option value="{{ value }}" {{ field and field.getOption('autocomplete', '') == value ? 'selected' : '' }}>{{ label|trans({}, 'xivi') }}</option>
			{% endfor %}
		</select>
	</div>
{% endif %}

{% if 'region' in options %}
	{#
		Which country a number typed without a country code is read as (XIV-114).
		Blank is the useful answer for almost every field: it follows the country
		on the instance profile (§8.6) and keeps following it if that changes.
		What is decided here is how the *next* value typed into this field is
		read; nothing already stored moves, because a stored number is already
		E.164 and already carries its own country.
	#}
	<div class="col-sm-4">
		<label class="form-label small mb-1" for="opt_region">{{ 'field.region'|trans }}</label>
		<select id="opt_region" class="form-select form-select-sm" name="region">
			<option value="">{{ 'field.region_default'|trans }}</option>
			{% for code, name in regionChoices %}
				<option value="{{ code }}" {{ field and field.getOption('region', '') == code ? 'selected' : '' }}>{{ name }}</option>
			{% endfor %}
		</select>
	</div>
{% endif %}

{% if 'module' in options %}
	{#
		Which module a reference points at (XIV-144). Unlike every other control
		here this one has no useful blank: a reference pointing nowhere offers an
		empty picker and renders `#41` where a name belongs, so the engine refuses
		to write one.

		The empty option is drawn only while there is nothing to keep: a field
		being added, or one old enough to predate the rule. Anywhere else it would
		be an invitation to break a field that works, and where there *is* nothing
		to keep, leaving it out would silently point the field at whichever module
		sorted first.

		A module's own reference is drawn as what it is rather than as a control,
		because its target is what the module's own forms, documents and totals
		expect, which is the reason its type is text and not a select. The hidden
		input is what keeps the save honest: this form names every setting it
		draws, so the one it deliberately does not draw still has to arrive
		unchanged.
	#}
	{% set target = field ? field.getOption('module', '') : '' %}
	<div class="col-sm-4">
		<label class="form-label small mb-1" for="opt_module">{{ 'field.points_at'|trans }}</label>
		{% if field and field.system %}
			<p class="form-control-plaintext form-control-sm mb-0">{{ moduleChoices[target]|default(target) }}</p>
			<input type="hidden" name="module" value="{{ target }}">
		{% else %}
			<select id="opt_module" class="form-select form-select-sm" name="module" required>
				{% if not target %}
					<option value="">{{ 'common.none'|trans }}</option>
				{% endif %}
				{% for key, label in moduleChoices %}
					<option value="{{ key }}" {{ target == key ? 'selected' : '' }}>{{ label }}</option>
				{% endfor %}
			</select>
		{% endif %}
	</div>
{% endif %}

{% if 'choices' in options %}
	{#
		The options a choice field is a choice between, asked while the field is
		being made (XIV-144).

		Drawn here and nowhere else: once the field exists its options have a page
		of their own, because editing them is a row each, a rename that must not
		move a record and a removal that may be refused with a paragraph. The one
		place that has to ask up front is this one, since the engine refuses to
		write a choice field with nothing to choose between and there is no page
		belonging to a field that does not exist yet.

		Not `required`, because the shared list beside it answers the same
		question (XIV-127) and either finishes the field. Sending neither is
		refused by the engine, in a sentence naming both.
	#}
	<div class="col-sm-6">
		<label class="form-label small mb-1" for="opt_choices">{{ 'field.options.add_label'|trans }}</label>
		<textarea id="opt_choices" class="form-control form-control-sm" name="choices"
		          rows="3" placeholder="{{ 'field.options.add_placeholder'|trans }}"></textarea>
		<p class="form-text small mb-0">{{ 'field.options.add_help'|trans|raw }}</p>
	</div>
{% endif %}

{% if 'list' in options %}
	{#
		Which shared list a choice field takes its values from (XIV-127), and
		**blank is a real answer here**, unlike the reference target above: it
		means the field keeps its own options, which is what every choice field in
		every tenant does and carries on doing without anybody touching this
		control.

		A module's own choice field is drawn as text rather than as a select, on
		the same terms as its reference target: an order's `status` options are
		the states its lifecycle moves records between, and a list the customer
		maintains is a list the customer can take entries out of.
	#}
	{% set list = field ? field.getOption('list', '') : '' %}
	<div class="col-sm-4">
		<label class="form-label small mb-1" for="opt_list">{{ 'field.takes_from'|trans }}</label>
		{% if field and field.system %}
			<p class="form-control-plaintext form-control-sm mb-0">{{ 'field.takes_from_own'|trans }}</p>
			<input type="hidden" name="list" value="{{ list }}">
		{% else %}
			<select id="opt_list" class="form-select form-select-sm" name="list">
				<option value="">{{ 'field.takes_from_own'|trans }}</option>
				{% for key, label in listChoices %}
					<option value="{{ key }}" {{ list == key ? 'selected' : '' }}>{{ label }}</option>
				{% endfor %}
			</select>
		{% endif %}
	</div>
{% endif %}

{% if 'exclusive_within' in options %}
	{#
		What a period may not overlap another one within (XIV-136). The room, the
		machine, the carer: a field beside this one, whose value says which thing
		is being occupied. Choosing one builds a database constraint that refuses
		two overlapping periods for the same thing, not a check that can be raced,
		which is why the engine counts the records that already overlap and
		refuses the change rather than building something that enforces nothing.

		Blank is the ordinary answer and clears the rule: two projects running at
		once are not a conflict. Only this shape's other fields are offered,
		because that is all the constraint can name.
	#}
	<div class="col-sm-4">
		<label class="form-label small mb-1" for="opt_exclusive_within">{{ 'field.exclusive_within'|trans }}</label>
		<select id="opt_exclusive_within" class="form-select form-select-sm" name="exclusive_within">
			<option value="">{{ 'field.exclusive_within_none'|trans }}</option>
			{% for other in scopeChoices %}
				{% if not field or other.key != field.key %}
					<option value="{{ other.key }}" {{ field and field.getOption('exclusive_within', '') == other.key ? 'selected' : '' }}>{{ other.label }}</option>
				{% endif %}
			{% endfor %}
		</select>
	</div>
{% endif %}
