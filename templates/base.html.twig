<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}{{ tenant_name|default('Xivi') }}{% endblock %}</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22>17</text></svg>">
		{% block stylesheets %}
			<style>
				:root {
					color-scheme: light dark;
					--bg: #f6f7f9;
					--surface: #fff;
					--text: #1c2024;
					--muted: #5f6672;
					--line: #dfe3e8;
					--accent: #2f5cff;
					--danger: #b3261e;
				}

				@media (prefers-color-scheme: dark) {
					:root {
						--bg: #14171a;
						--surface: #1c2024;
						--text: #e8eaed;
						--muted: #9aa2ad;
						--line: #2c3239;
						--accent: #7f9bff;
						--danger: #f2a099;
					}
				}

				* { box-sizing: border-box; }

				body {
					margin: 0;
					min-height: 100vh;
					font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
					background: var(--bg);
					color: var(--text);
				}

				a { color: var(--accent); }

				.shell {
					max-width: 60rem;
					margin: 0 auto;
					padding: 2rem 1.25rem;
				}

				.centered {
					display: grid;
					place-items: center;
					min-height: 100vh;
					padding: 1.25rem;
				}

				.card {
					width: 100%;
					max-width: 24rem;
					background: var(--surface);
					border: 1px solid var(--line);
					border-radius: 12px;
					padding: 2rem;
				}

				h1 { font-size: 1.35rem; margin: 0 0 .35rem; }

				.muted { color: var(--muted); font-size: .9rem; margin: 0 0 1.5rem; }

				label { display: block; font-size: .85rem; font-weight: 600; margin: 0 0 .35rem; }

				input[type="email"], input[type="password"] {
					width: 100%;
					padding: .6rem .7rem;
					margin-bottom: 1rem;
					font: inherit;
					color: inherit;
					background: var(--bg);
					border: 1px solid var(--line);
					border-radius: 8px;
				}

				input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

				button {
					width: 100%;
					padding: .65rem 1rem;
					font: inherit;
					font-weight: 600;
					color: #fff;
					background: var(--accent);
					border: 0;
					border-radius: 8px;
					cursor: pointer;
				}

				.alert {
					padding: .7rem .8rem;
					margin-bottom: 1.25rem;
					font-size: .9rem;
					color: var(--danger);
					border: 1px solid currentColor;
					border-radius: 8px;
				}

				.topbar {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 1rem;
					padding-bottom: 1rem;
					border-bottom: 1px solid var(--line);
				}

				.topbar form { margin: 0; }
				.topbar button { width: auto; background: none; color: var(--accent); padding: .35rem 0; }
			</style>
		{% endblock %}
	</head>
	<body>
		{% block body %}{% endblock %}
	</body>
</html>
