<!DOCTYPE html>
{# The document's language, so screen readers and browser translation
   follow the same choice the person made (XIV-8). #}
<html lang="{{ app.request.locale }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Xivi{% endblock %}</title>
		{# The installation's own mark when it has one (XIV-48), and the generation
		   drawn as text when it has not — which is what a fresh clone shows. No
		   `type`: the deployment chooses the format, and a wrong one stated here
		   is worse than none stated at all. #}
		{% if chrome.logo %}
			<link rel="icon" href="{{ asset(chrome.logo) }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22>17</text></svg>">
		{% endif %}

		{# Bootstrap does not follow the operating system's setting on its own, and
		   this has to run before the body paints or the page flashes white. #}
		<script>
			document.documentElement.dataset.bsTheme =
				window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		</script>

		{% block stylesheets %}{% endblock %}
		{% block javascripts %}{{ importmap('app') }}{% endblock %}
	</head>
	<body class="bg-body-tertiary d-flex flex-column min-vh-100">
		{% block body %}{% endblock %}

		{#
			Which version you are looking at, on every page including the login.
			The first question about any bug report, and the one nobody can answer
			from memory.
		#}
		<footer class="container page-shell mt-auto py-3">
			<p class="text-body-secondary small mb-0">Xivi {{ app_version }}</p>
		</footer>
	</body>
</html>
