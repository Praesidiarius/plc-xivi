{% extends 'base.html.twig' %}

{# The very same list the document templates page draws, from the very same
   markers — there is one marker set, not one per kind of template (XIV-38). #}
{% import '_markers.html.twig' as reference %}

{% block title %}{{ 'email_template.templates'|trans }} — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
			<div>
				<h1 class="h3 mb-1">
					{{ template ? template.name : ('email_template.write'|trans) }}
				</h1>
				<p class="text-body-secondary mb-0">{{ 'email_template.form_intro'|trans }}</p>
			</div>
			<a class="btn btn-link" href="{{ path('email_template_index', {module: module.key}) }}">{{ 'common.back'|trans }}</a>
		</div>

		<div class="row g-4">
			<div class="col-lg-7">
				<div class="card">
					<div class="card-body">
						{#
							One form for writing a new template and for changing an old
							one; only where it posts to differs. Nothing here is a file
							input, which is the whole point of the ticket — an email has
							no layout worth designing in Word, so it is written where it
							is read.
						#}
						<form method="post" action="{{ template
							? path('email_template_update', {module: module.key, template: template.id})
							: path('email_template_create', {module: module.key}) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('module-email-templates') }}">

							<div class="mb-3">
								<label class="form-label" for="name">{{ 'common.name'|trans }}</label>
								<input class="form-control" type="text" id="name" name="name" required
								       maxlength="{{ maxLine }}" value="{{ draft.name }}"
								       placeholder="{{ 'email_template.name_placeholder'|trans }}">
								<div class="form-text">{{ 'email_template.name_help'|trans }}</div>
							</div>

							{% if variants is not empty %}
								<div class="mb-3">
									<label class="form-label" for="variant">{{ 'document.applies_to'|trans }}</label>
									<select class="form-select" id="variant" name="variant">
										<option value="">{{ 'document.every_record'|trans }}</option>
										{% for key, label in variants %}
											<option value="{{ key }}" {{ draft.variant == key ? 'selected' : '' }}>{{ label }}</option>
										{% endfor %}
									</select>
									<div class="form-text">{{ 'document.applies_to_help'|trans }}</div>
								</div>
							{% endif %}

							<div class="mb-3">
								<label class="form-label" for="subject">{{ 'email_template.subject'|trans }}</label>
								<input class="form-control" type="text" id="subject" name="subject" required
								       maxlength="{{ maxLine }}" value="{{ draft.subject }}"
								       placeholder="{{ 'email_template.subject_placeholder'|trans }}">
								<div class="form-text">{{ 'email_template.subject_help'|trans }}</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="body">{{ 'email_template.body'|trans }}</label>
								{#
									A textarea, not an editor with buttons. Markdown is what
									gets stored, because it is also what the plain-text half
									of the message is — a rich-text editor would have left
									us generating that half from HTML.
								#}
								<textarea class="form-control font-monospace" id="body" name="body" rows="16" required
								          placeholder="{{ 'email_template.body_placeholder'|trans }}">{{ draft.body }}</textarea>
								<div class="form-text">{{ 'email_template.body_help'|trans }}</div>
							</div>

							<button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button>
						</form>
					</div>
				</div>
			</div>

			<div class="col-lg-5">
				{#
					The reference list, which is half the reason this page exists:
					somebody writing an email has to know what they may type, and the
					answer comes from this customer's own definitions rather than from
					documentation that would go stale the first time they add a field.

					A collections section too, since XIV-62 — but not the document page's
					one. There a marker names a *column* and the table row around it is
					what repeats; here one marker is the whole table, so the token that
					belongs on this page is `[lines]` rather than `[lines.description]`.
					Printing the document's tokens here would be printing a vocabulary
					that means something else on the page it is printed on.
				#}
				<div class="card">
					<div class="card-body">
						<h2 class="h6 text-uppercase text-body-secondary mb-2">{{ 'document.placeholders'|trans }}</h2>
						<p class="text-body-secondary small">{{ 'email_template.placeholders_help'|trans }}</p>

						{% for variant, markerList in markers %}
							{% if variant %}
								<h3 class="h6 mt-3">{{ 'document.for_variant'|trans({'%variant%': variants[variant]|default(variant)}) }}</h3>
							{% endif %}

							{{ reference.list(markerList) }}
						{% endfor %}

						<section id="general-markers">
							<h3 class="h6 mt-4">{{ 'document.general'|trans }}</h3>
							<p class="text-body-secondary small mb-2">{{ 'document.general_help'|trans }}</p>

							{{ reference.list(general) }}
						</section>

						{#
							The rows a message lists rather than states (XIV-62).

							Their own section, and the prose under the heading is not
							decoration: `[lines]` sits in a list beside `[first_name]`
							looking exactly like it, and one of them expands to a whole
							table. Somebody who pastes it into the middle of a sentence
							finds that out from the email they have just sent, which is
							the mistake the picture badge one list up exists to stop.
						#}
						{% for section in collections %}
							<section class="mt-4 email-collection-markers">
								<h3 class="h6">{{ section.collection.label }}</h3>
								<p class="text-body-secondary small mb-2">{{ 'email_template.collection_help'|trans }}</p>

								{{ reference.list(section.markers) }}

								{#
									The named-column form, as one worked example built
									from this collection's own fields rather than as a
									sentence of grammar. Nobody reads a grammar; almost
									everybody can copy a line and delete a word from it.
								#}
								<p class="text-body-secondary small mt-2 mb-0">
									{{ 'email_template.collection_columns_help'|trans({'%example%': section.example}) }}
								</p>

								{% if section.collection.hasVariants %}
									<p class="text-body-secondary small mt-2 mb-0">{{ 'email_template.collection_kinds_help'|trans }}</p>
								{% endif %}
							</section>
						{% endfor %}
					</div>
				</div>

				<div class="card mt-4">
					<div class="card-body">
						<h2 class="h6 text-uppercase text-body-secondary mb-2">{{ 'email_template.wrapper'|trans }}</h2>
						{#
							Said out loud rather than left to be discovered: what is
							written here is the content part, and the skeleton around it
							ships with the application (§5.13, §6.1).
						#}
						<p class="text-body-secondary small mb-0">{{ 'email_template.wrapper_help'|trans }}</p>
					</div>
				</div>
			</div>
		</div>
	</main>
{% endblock %}
