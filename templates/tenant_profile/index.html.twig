{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-1">{{ 'profile.title'|trans }}</h1>
		<p class="text-body-secondary">{{ 'profile.intro'|trans }}</p>

		{#
			Read and change are separate grants, so somebody may well be looking at
			this page without being the person who decides what is on it. The fields
			are disabled and the button is gone rather than the page being refused —
			what the instance prices in is a fact worth being able to look up.
		#}
		{% set editable = can('edit', area) %}

		{# multipart since XIV-49: the logo is a file, and a form that posts one
		   without this sends the file's *name* and nothing else — which fails as
		   a submission that appears to have worked. #}
		<form method="post" action="{{ path('tenant_profile_save') }}" enctype="multipart/form-data" class="card">
			<div class="card-body">
				<input type="hidden" name="_token" value="{{ csrf_token('tenant-profile') }}">

				<div class="mb-3">
					<label class="form-label" for="company_name">{{ 'profile.company_name'|trans }}</label>
					<input class="form-control" type="text" id="company_name" name="company_name"
					       maxlength="255" value="{{ profile.companyName }}" {{ editable ? '' : 'disabled' }}>
					<div class="form-text">{{ 'profile.company_name_help'|trans }}</div>
				</div>

				{#
					The customer's own mark (XIV-49).

					Directly under the company name because it is the other half of
					the same answer: what they are called, and what that looks like.
					It goes in the bar above and on the sign-in page of this
					hostname, which is the sentence the help text has to carry —
					somebody uploading a logo here should not be surprised later by
					where it turned up.

					**What is on file is shown, and it is shown from the same URL
					the rest of the application draws it from.** A preview built
					some other way — a data URI, a second route — would be a second
					thing that could be right while the real one was wrong. If the
					mark on this page is stale, the mark in the bar is stale, and
					that is a bug worth being able to see here.

					Removing is a checkbox rather than a blank field, because the
					file input is blank on every load: a browser cannot be handed
					the stored file back, so an empty input already means "leave it
					alone" and cannot also mean "get rid of it". Only offered when
					there is something to remove, and only to somebody who may
					change things.
				#}
				<div class="mb-3">
					<label class="form-label" for="logo">{{ 'profile.logo'|trans }}</label>

					{% if profile.hasLogo %}
						<div class="mb-2 p-2 border rounded bg-body-tertiary d-inline-block">
							{# Decorative: the field is labelled and the company name is
							   in the box above it, so announcing the picture as well
							   would be saying the same thing a third time. #}
							{{ include('_brand_mark.html.twig', {height: 48, alt: ''}) }}
						</div>
					{% endif %}

					<input class="form-control" type="file" id="logo" name="logo"
					       accept="{{ logoAccepts }}" {{ editable ? '' : 'disabled' }}>
					<div class="form-text">{{ 'profile.logo_help'|trans({'%size%': logoMaxKib}) }}</div>

					{% if profile.hasLogo and editable %}
						<div class="form-check mt-2">
							<input class="form-check-input" type="checkbox" value="1"
							       id="logo_remove" name="logo_remove">
							<label class="form-check-label" for="logo_remove">{{ 'profile.logo_remove'|trans }}</label>
						</div>
					{% endif %}
				</div>

				<div class="mb-3">
					<label class="form-label" for="currency">{{ 'profile.currency'|trans }}</label>
					<select class="form-select" id="currency" name="currency" {{ editable ? '' : 'disabled' }}>
						{# Not chosen is a real answer, and the one every instance starts on. #}
						<option value="">{{ 'profile.currency_none'|trans }}</option>
						{% for code, name in currencies %}
							<option value="{{ code }}" {{ profile.currency == code ? 'selected' : '' }}>
								{{ name }} ({{ code }})
							</option>
						{% endfor %}
					</select>
					<div class="form-text">{{ 'profile.currency_help'|trans }}</div>
				</div>

				{# Which country this installation writes numbers and dates like
				   (XIV-50). Its people are mostly in one place; whoever is not
				   says so on their own account. #}
				<div class="mb-3">
					<label class="form-label" for="region">{{ 'profile.region'|trans }}</label>
					<select class="form-select" id="region" name="region" {{ editable ? '' : 'disabled' }}>
						<option value="">{{ 'profile.region_none'|trans }}</option>
						{% for code, name in regions %}
							<option value="{{ code }}" {{ profile.region == code ? 'selected' : '' }}>
								{{ name }}
							</option>
						{% endfor %}
					</select>
					<div class="form-text">{{ 'profile.region_help'|trans }}</div>
				</div>

				{# Which clock this installation reads a moment on (XIV-83).
				   Directly under the region because the region usually answers
				   it: where a country has exactly one zone nothing is asked, and
				   the empty option names what that derived to — including the
				   case where it derived to nothing and everything is being shown
				   in UTC, which is the one a Spanish or American customer needs
				   to see. #}
				<div class="mb-3">
					<label class="form-label" for="timezone">{{ 'profile.timezone'|trans }}</label>
					<select class="form-select" id="timezone" name="timezone" {{ editable ? '' : 'disabled' }}>
						<option value="">{{ 'profile.timezone_none'|trans({'%zone%': timezoneDerived}) }}</option>
						{% for identifier, name in timezones %}
							<option value="{{ identifier }}" {{ profile.timezone == identifier ? 'selected' : '' }}>
								{{ name }}
							</option>
						{% endfor %}
					</select>
					<div class="form-text">{{ 'profile.timezone_help'|trans }}</div>
				</div>

				{# How long a customer gets to pay, when nothing on the customer
				   says otherwise (XIV-67). Empty is a real answer and the one
				   every installation starts on: no term means no due date, and a
				   document with no due date is never overdue. #}
				<div class="mb-3">
					<label class="form-label" for="payment_terms_days">{{ 'profile.payment_terms'|trans }}</label>
					<input class="form-control" type="number" inputmode="numeric" min="0" max="365"
					       id="payment_terms_days" name="payment_terms_days"
					       value="{{ profile.paymentTermsDays }}" {{ editable ? '' : 'disabled' }}>
					<div class="form-text">{{ 'profile.payment_terms_help'|trans }}</div>
				</div>

				{#
					Who this installation's mail comes from, and which server it
					leaves through (XIV-37). The two are one decision — see
					docs/architecture.md §8.7 — so they sit under one heading and
					the help text says which of the two you are choosing.
				#}
				<hr class="my-4">

				<h2 class="h5">{{ 'profile.mail'|trans }}</h2>
				<p class="text-body-secondary">{{ 'profile.mail_intro'|trans }}</p>

				<div class="mb-3">
					<label class="form-label" for="mail_sender_address">{{ 'profile.mail_sender_address'|trans }}</label>
					<input class="form-control" type="email" id="mail_sender_address" name="mail_sender_address"
					       maxlength="255" value="{{ profile.mailSenderAddress }}" {{ editable ? '' : 'disabled' }}>
					<div class="form-text">{{ 'profile.mail_sender_address_help'|trans }}</div>
				</div>

				<div class="row">
					<div class="col-md-8 mb-3">
						<label class="form-label" for="mail_smtp_host">{{ 'profile.mail_smtp_host'|trans }}</label>
						<input class="form-control" type="text" id="mail_smtp_host" name="mail_smtp_host"
						       maxlength="255" value="{{ profile.mailSmtpHost }}" {{ editable ? '' : 'disabled' }}>
						<div class="form-text">{{ 'profile.mail_smtp_host_help'|trans }}</div>
					</div>

					<div class="col-md-4 mb-3">
						<label class="form-label" for="mail_smtp_port">{{ 'profile.mail_smtp_port'|trans }}</label>
						<input class="form-control" type="number" id="mail_smtp_port" name="mail_smtp_port"
						       min="1" max="65535" value="{{ profile.mailSmtpPort }}" {{ editable ? '' : 'disabled' }}>
						<div class="form-text">{{ 'profile.mail_smtp_port_help'|trans }}</div>
					</div>
				</div>

				<div class="row">
					<div class="col-md-6 mb-3">
						<label class="form-label" for="mail_smtp_user">{{ 'profile.mail_smtp_user'|trans }}</label>
						<input class="form-control" type="text" id="mail_smtp_user" name="mail_smtp_user"
						       maxlength="255" value="{{ profile.mailSmtpUser }}" autocomplete="off"
						       {{ editable ? '' : 'disabled' }}>
					</div>

					{# Rendered empty every time: a stored secret is not sent back to a
					   browser, so blank means "unchanged" rather than "no password". #}
					<div class="col-md-6 mb-3">
						<label class="form-label" for="mail_smtp_password">{{ 'profile.mail_smtp_password'|trans }}</label>
						<input class="form-control" type="password" id="mail_smtp_password" name="mail_smtp_password"
						       value="" autocomplete="new-password" {{ editable ? '' : 'disabled' }}>
						<div class="form-text">
							{{ (profile.encryptedMailSmtpPassword ? 'profile.mail_smtp_password_set' : 'profile.mail_smtp_password_help')|trans }}
						</div>
					</div>
				</div>

				{% if editable %}
					<button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button>
				{% else %}
					<p class="text-body-secondary mb-0">{{ 'profile.read_only'|trans }}</p>
				{% endif %}
			</div>
		</form>
	</main>
{% endblock %}
