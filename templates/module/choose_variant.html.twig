{% extends 'base.html.twig' %}

{% block title %}New {{ module.label|lower }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">What kind?</h1>
			<a class="btn btn-link" href="{{ path('module_index', {module: module.key}) }}">Back</a>
		</div>

		{#
			Asked before the form is drawn, because the fields depend on the answer
			(§5.5) — a company has no first name. Switching them live would need
			JavaScript, and the forms here work without it.

			The options are the variant field's own options, so adding a kind is
			adding an option to that field and this page follows.
		#}
		<div class="row g-3">
			{% for value, label in variants %}
				<div class="col-sm-6">
					<a class="card module-tile h-100 text-decoration-none"
					   href="{{ path('module_new', {module: module.key, variant: value}) }}">
						<div class="card-body d-flex align-items-center gap-3">
							<i class="bi bi-{{ module.icon }} fs-3 text-body-secondary" aria-hidden="true"></i>
							<span class="fw-semibold">{{ label }}</span>
						</div>
					</a>
				</div>
			{% endfor %}
		</div>
	</main>
{% endblock %}
