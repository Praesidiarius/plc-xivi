{% extends 'base.html.twig' %}

{% block title %}Import — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">Import {{ module.label|lower }}</h1>

		{#
			One upload, two buttons. Nothing is kept between checking and importing —
			§5.6 asks for an upload and no file storage — so applying means picking
			the file again, which is the honest price of leaving nothing behind.
		#}
		<form method="post" enctype="multipart/form-data" class="card mb-3">
			<div class="card-body">
				<input type="hidden" name="_token" value="{{ csrf_token('import-records') }}">

				<div class="mb-3">
					<label class="form-label" for="file">Spreadsheet</label>
					<input class="form-control" type="file" id="file" name="file" accept=".xlsx" required>
					<div class="form-text">
						An export of this module is exactly the shape it expects: one sheet named
						<code>{{ module.key }}</code>{% for collection in module.collections %}, one named
						<code>{{ collection.key }}</code>{% endfor %}.
					</div>
				</div>

				<div class="d-flex align-items-center gap-2">
					<button class="btn btn-outline-secondary" type="submit" name="action" value="check">
						<i class="bi bi-search" aria-hidden="true"></i> Check
					</button>
					<button class="btn btn-primary" type="submit" name="action" value="apply">
						<i class="bi bi-upload" aria-hidden="true"></i> Import
					</button>
					<a class="btn btn-link ms-auto" href="{{ path('module_index', {module: module.key}) }}">Back to the list</a>
				</div>
			</div>
		</form>

		{% if report %}
			{% if report.isClean %}
				<div class="alert alert-info">
					<h2 class="h6">Nothing was changed — this is what importing would do.</h2>
					{#
						Each line names its own shape, off the customer's definitions: this
						module is called Contacts here and something else at the next
						customer, and the engine has no business having a word of its own
						for it. The labels are used exactly as they are stored, which is
						also what keeps this readable when they are not in English.
					#}
					<ul class="mb-0">
						<li>
							<strong>{{ module.label }}</strong>:
							{{ report.created }} added, {{ report.updated }} updated
						</li>
						{% for key, counts in report.collections %}
							{% set collection = module.getCollection(key) %}
							<li>
								<strong>{{ collection ? collection.label : key }}</strong>:
								{{ counts.written }} written{#-
									The one thing an import destroys, so it is said in as many
									words rather than left to be discovered afterwards.
								-#}
								{%- if counts.removed > 0 %},
									<span class="text-danger">{{ counts.removed }} <strong>removed</strong>,
									because the file does not list {{ counts.removed == 1 ? 'it' : 'them' }}</span>
								{%- else %}, {{ counts.removed }} removed
								{%- endif %}
							</li>
						{% endfor %}
					</ul>
				</div>
			{% else %}
				<div class="alert alert-warning">
					<h2 class="h6">
						Nothing was changed. {{ report.problems|length }}
						problem{{ report.problems|length == 1 ? '' : 's' }} to fix first:
					</h2>
					{# Every one of them, not the first: somebody fixing a file wants the list. #}
					<ul class="mb-0">
						{% for problem in report.problems %}
							<li>{{ problem.describe }}</li>
						{% endfor %}
					</ul>
				</div>
			{% endif %}
		{% endif %}

		<div class="card">
			<div class="card-body">
				<h2 class="h6">How a file is read</h2>
				<ul class="mb-0 small text-body-secondary">
					<li>A column may be named by a field's key or by its label.</li>
					<li>A field with no column keeps the value it had; a column left empty clears it.</li>
					<li>A row with an <code>id</code> updates that record. An empty <code>id</code> adds one.</li>
					<li>
						Anything else in <code>id</code> — <code>ada</code>, say — names a record this file
						is creating. That is how new records arrive with child rows: give each new record
						a name of your own in <code>id</code>, and put the same name in the child's
						<code>parent_id</code>. A record whose <code>id</code> is empty is created too,
						but nothing in the file can point at it.
					</li>
					<li>
						A child sheet speaks for the whole collection: a row it does not list is removed
						from the record. Leave the sheet out to keep them untouched.
					</li>
					<li>One problem anywhere refuses the whole file. There is no half-imported state.</li>
				</ul>
			</div>
		</div>
	</main>
{% endblock %}
