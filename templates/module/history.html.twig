{% extends 'base.html.twig' %}

{% import 'module/_history.html.twig' as h %}
{% import '_pager.html.twig' as pager %}

{% set title = record_title(module, record.data, record.id) %}

{% block title %}{{ 'module.history'|trans }} — {{ title }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
			<div>
				<h1 class="h3 mb-1">{{ 'module.history'|trans }}</h1>
				<p class="text-body-secondary mb-0">
					<a href="{{ path('module_show', {module: module.key, id: record.id}) }}">{{ title }}</a>
					<span class="ms-2">{{ 'module.history_all'|trans({'%count%': total}) }}</span>
				</p>
			</div>
			<a class="btn btn-link" href="{{ path('module_show', {module: module.key, id: record.id}) }}">
				{{ 'common.back'|trans }}
			</a>
		</div>

		{% if sections is empty %}
			<p class="text-body-secondary">{{ 'module.history_empty'|trans }}</p>
		{% else %}
			<div class="card">
				<div class="card-body">
					{#
						One section per age band, and the older ones start closed (XIV-3).
						The first is always open, so a page far enough back to hold nothing
						but old entries is not a screen of shut boxes — HistorySection
						decides that, not this template.
					#}
					{% for section in sections %}
						<details class="history-section {{ loop.first ? '' : 'border-top pt-3 mt-3' }}"
						         {{ section.folded ? '' : 'open' }}>
							<summary class="h6 text-uppercase text-body-secondary mb-2">
								{{ section.period.labelKey|trans({}, 'xivi') }}
								<span class="badge text-bg-light fw-normal">{{ section.entries|length }}</span>
							</summary>

							{{ h.entries(module, section.entries) }}
						</details>
					{% endfor %}
				</div>
			</div>

			<div class="mt-3">
				{{ pager.pager(
					'module_history',
					{module: module.key, id: record.id},
					page,
					pages,
					'module.pages'|trans
				) }}
			</div>
		{% endif %}
	</main>
{% endblock %}
