{% extends 'base.html.twig' %}

{% block title %}{{ module.label }}{% endblock %}

{% block body %}
	<div class="shell">
		{{ include('_topbar.html.twig') }}

		<div class="page-head">
			<h1>{{ module.label }}</h1>
			<a class="button" href="{{ path('module_new', {module: module.key}) }}">Add</a>
		</div>

		{{ include('_flashes.html.twig') }}

		{% if records is empty %}
			<p class="muted">Nothing here yet.</p>
		{% else %}
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							{# Columns come from the customer's own definitions, in their order. #}
							{% for field in module.fields %}
								<th>{{ field.label }}</th>
							{% endfor %}
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for record in records %}
							<tr>
								{% for field in module.fields %}
									<td>{{ display(field, record.get(field.key)) }}</td>
								{% endfor %}
								<td class="row-actions">
									<a href="{{ path('module_edit', {module: module.key, id: record.id}) }}">Edit</a>
									<form method="post" action="{{ path('module_delete', {module: module.key, id: record.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('delete-record-' ~ record.id) }}">
										<button type="submit" class="link danger">Delete</button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<p class="muted">{{ total }} record{{ total == 1 ? '' : 's' }}.</p>
		{% endif %}
	</div>
{% endblock %}
