{% import '_record_link.html.twig' as link %}
{% import '_pager.html.twig' as pager %}
{% extends 'base.html.twig' %}

{% block title %}{{ module.label }}{% endblock %}

{#
	A column header that sorts. Clicking the current sort turns it round, and any
	sort resets to page one — page 3 of a different order is not where you were.
#}
{% macro sortable(module, query, key, label) %}
	{% if key is empty %}
		{{ label }}
	{% else %}
		{# A key may name several fields; the first one carries the indicator. #}
		{% set current = query.sortOn(key|split(',')|first) %}
		{% set next = current and current.direction.value == 'asc' ? 'desc' : 'asc' %}
		<a class="text-decoration-none text-reset"
		   href="{{ path('module_index', app.request.query.all|merge({
			   module: module.key, sort: key, dir: next, page: null,
		   })) }}">
			{{ label }}
			{% if current %}<span aria-hidden="true">{{ current.direction.value == 'asc' ? '↑' : '↓' }}</span>{% endif %}
		</a>
	{% endif %}
{% endmacro %}

{% import _self as h %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ module.label }}</h1>
			<div class="d-flex align-items-center gap-2">
				{% if can('export', module) %}
					{# Carries the current query, so you download what you are looking at. #}
					<a class="btn btn-outline-secondary"
					   href="{{ path('module_export', app.request.query.all|merge({module: module.key})) }}">
						<i class="bi bi-download" aria-hidden="true"></i>
						<span class="d-none d-sm-inline">{{ 'common.export'|trans }}</span>
					</a>
				{% endif %}
				{# Its own permission now, not ROLE_ADMIN — so somebody granted it
				   can see the button they are allowed to press (§7.5). #}
				{% if can('import', module) %}
					<a class="btn btn-outline-secondary" href="{{ path('module_import', {module: module.key}) }}">
							<i class="bi bi-upload" aria-hidden="true"></i>
							<span class="d-none d-sm-inline">{{ 'common.import'|trans }}</span>
						</a>
				{% endif %}
				{# Keeping the stationery, which is its own grant: whoever designs the
				   invoice is not whoever sends one (XIV-4). #}
				{% if can('templates', module) %}
					<a class="btn btn-outline-secondary" href="{{ path('module_templates', {module: module.key}) }}">
							<i class="bi bi-file-earmark-word" aria-hidden="true"></i>
							<span class="d-none d-sm-inline">{{ 'document.templates'|trans }}</span>
						</a>
				{% endif %}
				{# And what its emails say, which is a wording job rather than a
				   design one — its own grant for that reason (XIV-38). #}
				{% if can('email_templates', module) %}
					<a class="btn btn-outline-secondary" href="{{ path('email_template_index', {module: module.key}) }}">
							<i class="bi bi-envelope" aria-hidden="true"></i>
							<span class="d-none d-sm-inline">{{ 'email_template.templates'|trans }}</span>
						</a>
				{% endif %}
				{# The metadata editor stays an administrator's job: it changes what
				   the module *is*, which is not one of its permissions (§5.4). #}
				{% if is_granted('ROLE_ADMIN') %}
					<a class="btn btn-outline-secondary" href="{{ path('field_index', {module: module.key}) }}">
							<i class="bi bi-sliders" aria-hidden="true"></i> {{ 'common.fields'|trans }}
						</a>
				{% endif %}
				{% if can('add', module) %}
					<a class="btn btn-primary" href="{{ path('module_new', {module: module.key}) }}">
							<i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'common.add'|trans }}
						</a>
				{% endif %}
			</div>
		</div>

		{% if filterable is not empty %}
			{#
				A GET form, so a filtered list is a URL: it can be bookmarked, shared
				and reloaded. One row per active filter plus a blank one, the same way
				the record form handles collections — emptying a row removes it, so
				this works with scripting off.
			#}
			<form method="get" class="card mb-3">
				<div class="card-body pb-2">
					{% for i in 0..query.filters|length %}
						{% set filter = query.filters[i] ?? null %}
						<div class="row g-2 align-items-center mb-2">
							<div class="col-sm-4">
								<select name="filter[{{ i }}][path]" class="form-select form-select-sm">
									<option value="">—</option>
									{% for path, label in filterable %}
										<option value="{{ path }}" {{ filter and filter.path == path ? 'selected' : '' }}>{{ label }}</option>
									{% endfor %}
								</select>
							</div>
							<div class="col-sm-3">
								<select name="filter[{{ i }}][op]" class="form-select form-select-sm">
									{% for operator in operators %}
										<option value="{{ operator.value }}" {{ filter and filter.operator == operator ? 'selected' : '' }}>{{ operator.labelKey|trans({}, 'xivi') }}</option>
									{% endfor %}
								</select>
							</div>
							<div class="col-sm-4">
								<input type="text" class="form-control form-control-sm" name="filter[{{ i }}][value]"
									   value="{{ filter ? filter.value : '' }}" placeholder="{{ 'module.filter_value'|trans }}">
							</div>
							<div class="col-sm-1 text-end">
								{% if loop.last %}<button class="btn btn-sm btn-primary" type="submit">{{ 'module.filter'|trans }}</button>{% endif %}
							</div>
						</div>
					{% endfor %}

					{# The sort travels with the filter, or filtering would silently reorder. #}
					{% if query.sorts is not empty %}
						<input type="hidden" name="sort" value="{{ query.sorts[0].field }}">
						<input type="hidden" name="dir" value="{{ query.sorts[0].direction.value }}">
					{% endif %}

					{% if query.isFiltered %}
						<a class="btn btn-sm btn-link ps-0" href="{{ path('module_index', {module: module.key}) }}">{{ 'module.clear_filter'|trans }}</a>
					{% endif %}
				</div>
			</form>
		{% endif %}

		{% if records is empty %}
			{% if query.isFiltered %}
				{# A filter finding nothing is information, not an occasion. #}
				<div class="alert alert-secondary d-flex align-items-center gap-2">
					<i class="bi bi-funnel" aria-hidden="true"></i>
					{{ 'module.no_matches'|trans }}
				</div>
			{% else %}
				{# An empty module is somebody's first day, so point at the way in
				   rather than reporting a count of zero. #}
				<div class="card">
					<div class="card-body text-center py-5">
						<i class="bi bi-{{ module.icon }} display-4 text-body-secondary" aria-hidden="true"></i>
						<h2 class="h5 mt-3">{{ 'module.empty_title'|trans({'%module%': module.label|lower}) }}</h2>
						<p class="text-body-secondary mb-4">
							{{ 'module.empty_body'|trans }}
						</p>
						{% if can('add', module) %}
							<a class="btn btn-primary" href="{{ path('module_new', {module: module.key}) }}">
								<i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'module.add_first'|trans }}
							</a>
						{% endif %}
					</div>
				</div>
			{% endif %}
		{% else %}
			<div class="card">
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0">
						<thead>
							<tr>
								{# The name first, because it is the one thing every record has
								   whatever variant it is (§5.5), and the only sensible thing to
								   click. Then the customer's own listed fields, in their order. #}
								<th scope="col" class="text-body-secondary small text-uppercase">
									{{ h.sortable(module, query, nameSort, 'common.name'|trans) }}
								</th>
								{% for field in columns %}
									<th scope="col" class="text-body-secondary small text-uppercase">
										{{ h.sortable(module, query, field.key, field.label) }}
									</th>
								{% endfor %}
								<th scope="col" class="text-body-secondary small text-uppercase">{{ 'module.owner'|trans }}</th>
								{#
									**When this row was last touched** (XIV-132).

									A system column beside a system column: `owner_id` and
									`updated_at` are both written by the engine on every record of
									every module (§5.2), neither is a field anybody declared, and
									the one has been drawn here since the list existed. So this is
									the second half of a pair rather than a new idea, and like the
									first it sorts on nothing — a `RecordQuery` orders on the
									customer's own definitions, and these two are not among them.

									It is here because of what a knowledge base fails at. An empty
									one is obvious and harmless; a *confidently wrong* one — an
									entry from 2023 describing a process that changed in 2024,
									which somebody reads and follows — is the failure that costs
									something, and the only cheap defence is that the age is on the
									screen next to the entry rather than one click inside it. The
									record page has shown "Changed" in its right-hand card all
									along, which is the right place to find it and the wrong place
									to *notice* it: by the time you are reading the page you have
									already decided this is the answer.

									Every other module gets it too, and that is deliberate rather
									than collateral. "Which of these did somebody touch today" is a
									question a list of orders and a list of contacts get asked as
									often as a list of entries does, and a column the engine can
									fill for free on every module is not a knowledge-base feature
									that leaked — it is the generic thing this ticket happened to
									be the first to need.
								#}
								<th scope="col" class="text-body-secondary small text-uppercase">{{ 'module.changed'|trans }}</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							{% for record in records %}
								<tr>
									{# The name opens the record, which is where anyone clicking a
									   row expects to end up. #}
									<td>
										<a class="text-reset" href="{{ path('module_show', {module: module.key, id: record.id}) }}">
											{{ record_title(module, record.data, record.id) }}
										</a>
										{# Two field reads and no query (XIV-67), so a page of
										   twenty-five costs nothing extra — which is what lets
										   the answer be today's rather than a stored flag. #}
										{% if is_overdue(module, record) %}
											<span class="badge text-bg-danger ms-1" title="{{ 'module.overdue_title'|trans }}">
												{{- 'module.overdue'|trans -}}
											</span>
										{% endif %}
									</td>
									{% for field in columns %}
										<td>{{ link.linked(field, record.get(field.key), display(field, record.get(field.key))) }}</td>
									{% endfor %}
									{# owner_id is a system column; the name is resolved by the
									   application, since the engine does not know what a user is. #}
									<td class="text-body-secondary">{{ owners[record.ownerId] ?? '—' }}</td>
									{# The date alone, without the time: a list is scanned rather
									   than read, and "2024-11-03" answers "is this still current"
									   where "2024-11-03 16:42" makes the reader do the same
									   arithmetic through more digits. The full moment is a click
									   away on the record itself, and the exact one after that in
									   the timeline. `<time>` carries the machine-readable form so
									   the column is not merely a picture of a date. #}
									<td class="text-body-secondary">
										{%- if record.updatedAt -%}
											<time datetime="{{ record.updatedAt|date('c') }}">{{ record.updatedAt|date('Y-m-d') }}</time>
										{%- else -%}
											—
										{%- endif -%}
									</td>
									<td class="row-actions text-end">
										{# Asked about this row, not about the module: with a scope of
										   "own", the answer differs from one line to the next. #}
										{% if can('view', module, record) %}
											<a class="btn btn-sm btn-outline-secondary"
											   data-bs-toggle="tooltip" title="{{ 'module.view_record'|trans }}"
											   href="{{ path('module_show', {module: module.key, id: record.id}) }}">
												<i class="bi bi-eye" aria-hidden="true"></i>
												<span class="visually-hidden">{{ 'common.view'|trans }}</span>
											</a>
										{% endif %}
										{% if can('edit', module, record) %}
											<a class="btn btn-sm btn-outline-secondary"
											   data-bs-toggle="tooltip" title="{{ 'module.edit_record'|trans }}"
											   href="{{ path('module_edit', {module: module.key, id: record.id}) }}">
												<i class="bi bi-pencil" aria-hidden="true"></i>
												<span class="visually-hidden">{{ 'common.edit'|trans }}</span>
											</a>
										{% endif %}
										{% if can('delete', module, record) %}
											<form method="post" class="d-inline"
											      action="{{ path('module_delete', {module: module.key, id: record.id}) }}">
												<input type="hidden" name="_token" value="{{ csrf_token('delete-record-' ~ record.id) }}">
												<button type="submit" class="btn btn-sm btn-outline-danger"
												        data-bs-toggle="tooltip" title="{{ 'module.delete_record'|trans }}">
													<i class="bi bi-trash" aria-hidden="true"></i>
													<span class="visually-hidden">{{ 'common.delete'|trans }}</span>
												</button>
											</form>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			<div class="d-flex align-items-center justify-content-between mt-2">
				{#
					ICU rather than a ternary, because "one" and "other" are not the
					only two answers every language has, and building the sentence in
					Twig would bake English grammar into the template (XIV-8).
				#}
				<p class="text-body-secondary small mb-0">
					{{ (query.isFiltered ? 'module.record_count_matching' : 'module.record_count')|trans({'%count%': total}) }}
				</p>

				{#
					The query string goes in with the parameters, which is what keeps
					a filter and a sort alive across a page change (XIV-69).
				#}
				{{ pager.pager(
					'module_index',
					app.request.query.all|merge({module: module.key}),
					query.page,
					pages,
					'module.pages'|trans
				) }}
			</div>
		{% endif %}
	</main>
{% endblock %}
