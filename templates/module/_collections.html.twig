{#
	The collections of a record's form, on their own so htmx can swap them.

	Rendered inside form.html.twig on a full page, and alone as the response to
	adding or removing a row (XIV-29). One template either way: a fragment that
	drew rows differently from the page would be a second answer to "what does a
	row look like", and the two would drift.

	The whole block is replaced rather than one row appended, which is why nothing
	here counts indexes. The server rebuilds the form from what was submitted, so
	everything already typed comes back with it.
#}
<div id="record-collections">
	{% for collection in module.collections|filter(c => not c.derived) %}
		{# Derived collections are worked out during the save and never drawn
		   here (XIV-16), so the form has no branch for them at all. #}
		{% set entries = form.collections[collection.key] %}

		<div class="card mt-3">
			<div class="card-body">
				<h2 class="h5 mb-3">{{ collection.label }}</h2>

				{% for entry in entries %}
					<div class="row-of-collection border-top pt-3 mt-3">
						{#
							Where the row sits (XIV-21). Small and to the left of the row's
							own fields, because it is about the list rather than about the
							row: type 15 to put something between 10 and 20, and the save
							renumbers everything in tens again.
						#}
						<div class="row-position-cell">
							{{ form_widget(entry.position, {attr: {class: 'form-control form-control-sm'}}) }}
						</div>
						{#
							Which kind of row this is (XIV-20). A heading rather than a
							control: a row's kind is fixed once it exists, and offering to
							change it would be offering to make the row disagree with the
							fields it is showing.
						#}
						{% if collection.hasVariants %}
							{% set kind = entry.vars.data.fields[collection.variantField]|default(null) %}
							{% if kind %}
								<h3 class="h6 text-body-secondary">{{ collection.getVariants[kind]|default(kind) }}</h3>
							{% endif %}
						{% endif %}
						{{ form_widget(entry) }}

						{# Removing a row is a convenience over a rule that already holds:
						   a row cleared of its values is not saved. #}
						<button type="submit" class="btn btn-outline-danger btn-sm"
						        name="remove" value="{{ collection.key }}:{{ loop.index0 }}"
						        formnovalidate
						        hx-post="{{ app.request.requestUri }}"
						        hx-include="closest form"
						        hx-vals='{{ {remove: collection.key ~ ':' ~ loop.index0}|json_encode }}'
						        hx-target="#record-collections"
						        hx-swap="outerHTML">
							{{ 'common.remove'|trans }}
						</button>
					</div>
				{% endfor %}

				{#
					One button per kind (XIV-29), and only the kinds this customer can
					fill in — a kind whose required link points at a module they have
					not installed is not offered at all (XIV-23).

					Real submit buttons carrying what they mean, with htmx over the top:
					the server does the same thing either way and only the amount of
					page that comes back differs.
				#}
				<div class="d-flex flex-wrap gap-2 mt-3">
					{% for kind, label in kinds[collection.key]|default({}) %}
						<button type="submit" class="btn btn-outline-secondary btn-sm"
						        name="add" value="{{ collection.key }}:{{ kind }}"
						        formnovalidate
						        hx-post="{{ app.request.requestUri }}"
						        hx-include="closest form"
						        hx-vals='{{ {add: collection.key ~ ':' ~ kind}|json_encode }}'
						        hx-target="#record-collections"
						        hx-swap="outerHTML">
							{{ 'module.add_kind'|trans({'%kind%': label}) }}
						</button>
					{% endfor %}

					{% if kinds[collection.key]|default({}) is empty %}
						<button type="submit" class="btn btn-outline-secondary btn-sm"
						        name="add" value="{{ collection.key }}:"
						        formnovalidate
						        hx-post="{{ app.request.requestUri }}"
						        hx-include="closest form"
						        hx-vals='{{ {add: collection.key ~ ':'}|json_encode }}'
						        hx-target="#record-collections"
						        hx-swap="outerHTML">
							{{ 'module.add_row'|trans({'%collection%': collection.label|lower}) }}
						</button>
					{% endif %}
				</div>
			</div>
		</div>
	{% endfor %}
</div>
