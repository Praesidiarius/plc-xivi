{% extends 'base.html.twig' %}

{# The timeline is described once and read in two places — see the partial. #}
{% import 'module/_history.html.twig' as h %}

{# One answer to "what is this record called", from the engine (§5.4). #}
{% set title = record_title(module, record.data, record.id) %}

{% block title %}{{ title }} — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
			<div class="d-flex align-items-center gap-3">
				<i class="bi bi-{{ module.icon }} fs-2 text-body-secondary" aria-hidden="true"></i>
				<div>
					<h1 class="h3 mb-0">{{ title }}</h1>
					<p class="text-body-secondary small mb-0">{{ module.label }}</p>
				</div>
			</div>

			<div class="d-flex align-items-center gap-2">
				{# Back only leads anywhere if the list does: somebody may be allowed
				   to open a record they cannot browse to. #}
				{% if can('list', module) %}
					<a class="btn btn-link" href="{{ path('module_index', {module: module.key}) }}">{{ 'common.back'|trans }}</a>
				{% endif %}
				{% if can('edit', module, record) %}
					<a class="btn btn-primary" href="{{ path('module_edit', {module: module.key, id: record.id}) }}">
						<i class="bi bi-pencil" aria-hidden="true"></i> {{ 'common.edit'|trans }}
					</a>
				{% endif %}
				{% if can('delete', module, record) %}
					<form method="post" action="{{ path('module_delete', {module: module.key, id: record.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('delete-record-' ~ record.id) }}">
						<button type="submit" class="btn btn-outline-danger">
							<i class="bi bi-trash" aria-hidden="true"></i> {{ 'common.delete'|trans }}
						</button>
					</form>
				{% endif %}
			</div>
		</div>

		{# Two columns: the record on the left, context about it on the right.
		   Three equal cards stacked said everything mattered the same amount. #}
		<div class="row g-3">
			<div class="col-lg-8">
				<div class="card">
					<div class="card-body">
						{# The customer's own definitions, in their order — the same rows
						   that built the form, read instead of edited. Each pair takes
						   half the row, so two sit side by side on a wide screen. #}
						<dl class="row mb-0">
							{% for field in fields %}
								<dt class="col-6 col-md-3 text-body-secondary fw-normal">{{ field.label }}</dt>
								<dd class="col-6 col-md-3">
									{% set shown = display(field, record.get(field.key)) %}
									{# Empty reads quieter than filled, or a half-filled record
									   looks busier than a full one. #}
									{{ shown is empty ? '<span class="text-body-secondary">—</span>'|raw : shown }}
								</dd>
							{% endfor %}
						</dl>

						{# A section of the record, not a card beside it: an address belongs
						   to this contact rather than sitting next to it (§5.1). #}
						{% for collection in module.collections %}
							{% set rows = children[collection.key] %}

							<h2 class="h6 text-uppercase text-body-secondary border-top pt-3 mt-4">{{ collection.label }}</h2>

							{% if rows is empty %}
								<p class="text-body-secondary mb-0">{{ 'common.none'|trans }}</p>
							{% else %}
								<div class="table-responsive">
									<table class="table table-sm align-middle mb-0">
										<thead>
											<tr>
												{% for field in collection.fields %}
													<th scope="col" class="text-body-secondary small text-uppercase fw-normal">{{ field.label }}</th>
												{% endfor %}
											</tr>
										</thead>
										<tbody>
											{% for row in rows %}
												<tr>
													{% for field in collection.fields %}
														{% set shown = display(field, row.get(field.key)) %}
														<td>{{ shown is empty ? '<span class="text-body-secondary">—</span>'|raw : shown }}</td>
													{% endfor %}
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>
			</div>

			{#
				Records pointing at this one (§7.6) — a company's people. Read from
				the reference on their side rather than stored here, so the two can
				never disagree about who works where.
			#}
			{% for label, records in linked %}
				<div class="col-lg-8">
					<div class="card">
						<div class="card-body">
							<h2 class="h6 text-uppercase text-body-secondary mb-3">
								{{ records|length }} with this as {{ label|lower }}
							</h2>
							<ul class="list-unstyled mb-0">
								{% for linkedRecord in records %}
									<li class="{{ loop.first ? '' : 'border-top pt-2 mt-2' }}">
										<a href="{{ path('module_show', {module: module.key, id: linkedRecord.id}) }}">
											{{ record_title(module, linkedRecord.data, linkedRecord.id) }}
										</a>
									</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			{% endfor %}

			<div class="col-lg-4">
				<div class="card mb-3">
					<div class="card-body">
						<h2 class="h6 text-uppercase text-body-secondary mb-3">{{ 'module.record'|trans }}</h2>
						<dl class="row small mb-0">
							<dt class="col-5 fw-normal text-body-secondary">{{ 'module.owner'|trans }}</dt>
							<dd class="col-7">{{ owner ?? '—' }}</dd>
							{% if record.createdAt %}
								<dt class="col-5 fw-normal text-body-secondary">{{ 'module.created'|trans }}</dt>
								<dd class="col-7">{{ record.createdAt|date('Y-m-d H:i') }}</dd>
							{% endif %}
							{% if record.updatedAt %}
								<dt class="col-5 fw-normal text-body-secondary">{{ 'module.changed'|trans }}</dt>
								<dd class="col-7 mb-0">{{ record.updatedAt|date('Y-m-d H:i') }}</dd>
							{% endif %}
						</dl>
					</div>
				</div>

				{# History belongs on the record, not on the form: it is something you
				   read about a record, not something you edit (§5.2). The latest few
				   of it, at least — the whole timeline has a page of its own, so this
				   card is the same height on a record edited once and one edited every
				   day for a year (XIV-3). #}
				<div class="card">
					<div class="card-body">
						<h2 class="h6 text-uppercase text-body-secondary mb-3">{{ 'module.history'|trans }}</h2>

						{% if history is empty %}
							<p class="text-body-secondary small mb-0">
								{{ 'module.history_empty'|trans }}
							</p>
						{% else %}
							{{ h.entries(module, history) }}

							{# Said whenever there is more, and it says how much more: a
							   list that silently stopped at five is a list that lies. #}
							{% if historyTotal > historyShown %}
								<a class="small d-inline-block mt-3"
								   href="{{ path('module_history', {module: module.key, id: record.id}) }}">
									{{ 'module.history_all'|trans({'%count%': historyTotal}) }}
								</a>
							{% endif %}
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</main>
{% endblock %}
