{% import '_record_link.html.twig' as link %}
{% extends 'base.html.twig' %}

{# The timeline is described once and read in two places — see the partial. #}
{% import 'module/_history.html.twig' as h %}

{# One answer to "what is this record called", from the engine (§5.4). #}
{% set title = record_title(module, record.data, record.id) %}

{% block title %}{{ title }} — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
			<div class="d-flex align-items-center gap-3">
				<i class="bi bi-{{ module.icon }} fs-2 text-body-secondary" aria-hidden="true"></i>
				<div>
					<h1 class="h3 mb-0">{{ title }}</h1>
					<p class="text-body-secondary small mb-0">
						{{ module.label }}
						{% if lifecycle %}
							{# The state reads as a badge beside what the record is, because it
							   is what the record *is* right now (XIV-14). #}
							<span class="badge text-bg-secondary ms-1">
								{{- display(module.getField(lifecycle.lifecycle.field), record.get(lifecycle.lifecycle.field)) -}}
							</span>
						{% endif %}
						{# Late is not one of those states and deliberately never will
						   be (XIV-67): nobody *performs* overdue, the calendar does.
						   So it is worked out here, on every read, and sits beside
						   the state rather than replacing it — a record is still
						   sent, and additionally late. #}
						{% if is_overdue(module, record) %}
							<span class="badge text-bg-danger ms-1" title="{{ 'module.overdue_title'|trans }}">
								{{- 'module.overdue'|trans -}}
							</span>
						{% endif %}
					</p>
				</div>
			</div>

			<div class="d-flex align-items-center gap-2">
				{# Back only leads anywhere if the list does: somebody may be allowed
				   to open a record they cannot browse to. #}
				{% if can('list', module) %}
					<a class="btn btn-link" href="{{ path('module_index', {module: module.key}) }}">{{ 'common.back'|trans }}</a>
				{% endif %}
				{#
					One button, whether the record has one template or fifty (XIV-4).
					The href is a real page, so this works with JavaScript off; with it
					on, Bootstrap intercepts the click and the same form opens in the
					modal at the bottom of this page.
				#}
				{% if documents is not empty %}
					<a class="btn btn-outline-secondary"
					   href="{{ path('module_document_choose', {module: module.key, id: record.id}) }}"
					   data-bs-toggle="modal" data-bs-target="#document-modal">
						<i class="bi bi-file-earmark-text" aria-hidden="true"></i>
						<span class="d-none d-sm-inline">{{ 'document.documents'|trans }}</span>
					</a>
				{% endif %}
				{#
					Sending one of the module's emails from this record (XIV-39), and
					deliberately the button beside Documents rather than a different kind
					of thing: one button, whether there are two templates or fifty.

					Three states, and the middle one is the ticket's. A module that never
					said where its recipient comes from shows nothing at all — an
					articles list has nobody to write to, and that is an answer rather
					than a fault. A record whose address cannot be resolved shows the
					reason *instead of* the button, because a modal that opens and cannot
					be completed is worse than no button: it costs somebody three clicks
					to learn what one sentence could have told them.
				#}
				{% if emails.templates is not empty %}
					{% if emails.recipient.resolved %}
						<a class="btn btn-outline-secondary"
						   href="{{ path('module_email_choose', {module: module.key, id: record.id}) }}"
						   data-bs-toggle="modal" data-bs-target="#email-modal">
							<i class="bi bi-envelope" aria-hidden="true"></i>
							<span class="d-none d-sm-inline">{{ 'mail.send_email'|trans }}</span>
						</a>
					{% elseif emails.recipient.offered %}
						<p class="text-body-secondary small mb-0 align-self-center">{{ emails.recipient.reason|trans }}</p>
					{% endif %}
				{% endif %}
				{#
					Where the record is, and where it may go from here (XIV-14). Only
					the legal moves are drawn: a button that answers "not from there"
					is a button that should not have been offered.

					A move the record's state allows but its own condition refuses
					shows the module's reason instead of the button (XIV-110) — the
					same three-state shape as the send card above. The button is the
					courtesy; the enforcement is in the route, which asks the same
					guard again when the POST arrives, because a URL can be retyped.
				#}
				{% for offer in transitions %}
					{% if offer.possible %}
						<form method="post"
						      action="{{ path('module_transition', {module: module.key, id: record.id, transition: offer.transition.name}) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('transition-record-' ~ record.id) }}">
							<button type="submit" class="btn btn-outline-primary">
								{{ offer.transition.labelKey|trans({}, module.key) }}
							</button>
						</form>
					{% else %}
						<p class="text-body-secondary small mb-0 align-self-center">
							{{ offer.refusal|trans({}, module.key) }}
						</p>
					{% endif %}
				{% endfor %}
				{#
					What this record can be made into (XIV-19): an invoice from an
					order. A link rather than a form, because what it opens is the
					new record's form filled in — nothing is written until somebody
					has read it and pressed save.
				#}
				{% for offer in seeds %}
					<a class="btn btn-outline-primary"
					   href="{{ path('module_new', {module: offer.module.key, from: record.id}) }}">
						<i class="bi bi-{{ offer.module.icon }}" aria-hidden="true"></i>
						{{ offer.seed.label|trans({}, offer.module.key) }}
					</a>
				{% endfor %}
				{% if can('edit', module, record) and not (lifecycle and lifecycle.isLocked(record)) %}
					<a class="btn btn-primary" href="{{ path('module_edit', {module: module.key, id: record.id}) }}">
						<i class="bi bi-pencil" aria-hidden="true"></i> {{ 'common.edit'|trans }}
					</a>
				{% endif %}
				{% if can('delete', module, record) %}
					<form method="post" action="{{ path('module_delete', {module: module.key, id: record.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('delete-record-' ~ record.id) }}">
						<button type="submit" class="btn btn-outline-danger">
							<i class="bi bi-trash" aria-hidden="true"></i> {{ 'common.delete'|trans }}
						</button>
					</form>
				{% endif %}
			</div>
		</div>

		{#
			What is outstanding on this record, above the record itself (XIV-82).

			**Above the fields and nowhere else.** A follow-up is a claim on
			somebody's attention, and a claim below the fold is one that has been
			missed — so it sits between the record's name and the record's contents,
			at full width rather than in the right-hand column, which is where things
			you may want to read live rather than things you have to.

			It is emphatically **not on the list**: a page of twenty-five records
			asking each one what is outstanding on it is the N+1 §5.16 warned about,
			and a list is for scanning records rather than for reading the work
			outstanding on them.

			Asked here before it is mounted, so a module whose follow-ups are
			switched off constructs nothing at all — the component makes the same
			check for the page that was open across the moment somebody switched it,
			but the ordinary case should not build a component to have it draw
			nothing (§5.18).
		#}
		{% if module.hasFollowUps %}
			<twig:FollowUps module="{{ module.key }}" :recordId="record.id" />
		{% endif %}

		{# Two columns: the record on the left, context about it on the right.
		   Three equal cards stacked said everything mattered the same amount. #}
		<div class="row g-3">
			<div class="col-lg-8">
				<div class="card">
					<div class="card-body">
						{#
							The customer's own definitions, in their order — the same rows
							that built the form, read instead of edited. Each pair takes
							half the row, so two sit side by side on a wide screen.

							**In the same runs the form draws them in** (XIV-119), from
							the same method: `getFieldGroupsFor()`. A page that showed the
							sections and a form that did not, or the other way round,
							would be worse than neither doing it — so neither template
							decides, and both are handed the answer.

							With no sections this is one run and one `<dl>` with no
							heading over it, which is character for character the page
							that was here before this existed. A heading is only ever
							drawn for a section that has fields under it.
						#}
						{% for group in groups %}
						{% if group.section %}
							{# The customer's own word, never a translation key — the same
							   thing a field's label is, and the same reason (§5.4). #}
							<h2 class="h6 text-uppercase text-body-secondary {{ loop.first ? 'mb-3' : 'border-top pt-3 mt-4 mb-3' }}">{{ group.section.label }}</h2>
						{% endif %}
						<dl class="row mb-0">
							{% for field in group.fields %}
								{#
									A field that holds formatted text is the one thing here that
									is not a value on a line (XIV-131). `formatted()` asks the
									*field* rather than the template asking what type it is —
									the same rule `record_link()` follows one line down — and a
									type with no formatting to offer answers null, which is
									every other field on this page.

									It takes the whole row rather than a quarter of one, because
									what is in it has blocks: a heading, a list, a paragraph.
									Drawn in a `col-md-3` those wrap to two words a line and the
									formatting that is the entire point of the field becomes
									unreadable.

									This is the only place in the application where a record's
									own value reaches a page as markup rather than as text, and
									it is safe for one specific reason rather than by habit: it
									was parsed with raw HTML escaped and then sanitized, inside
									Xivi\Core\Markdown\MarkdownRenderer, which is the same object
									and the same policy an email goes through. Nothing here says
									`|raw`, and nothing here may.
								#}
								{% set rich = formatted(field, record.get(field.key)) %}

								{% if rich is not null %}
									<dt class="col-12 text-body-secondary fw-normal">{{ field.label }}</dt>
									<dd class="col-12">
										{% if rich is empty %}
											<span class="text-body-secondary">—</span>
										{% else %}
											<div class="markdown-body">{{ rich }}</div>
										{% endif %}
									</dd>
								{% else %}
									<dt class="col-6 col-md-3 text-body-secondary fw-normal">{{ field.label }}</dt>
									<dd class="col-6 col-md-3">
										{% set shown = display(field, record.get(field.key)) %}
										{# A colour and a picture, when the value carries them
										   (XIV-127). Asked of the field rather than of its type, on
										   `record_link()`'s rule; null — and therefore this page
										   exactly as it was — for every field that is not pointed at
										   a shared list. #}
										{% set badge = value_badge(field, record.get(field.key)) %}
										{# The file a value names, when it names one (XIV-115). Asked
										   of the field on `record_link()`'s rule, and drawn here
										   rather than by the form theme because this is the page
										   that knows which record it is showing: the download route
										   is addressed by module and id, which a form has no idea
										   of. The link is not what protects the file: the route
										   checks this record's own permissions before it reads a
										   byte (§8.4), so an address in a page somebody copies is
										   an address that will refuse them. #}
										{% set file = stored_file(field, record.get(field.key)) %}
										{# Empty reads quieter than filled, or a half-filled record
										   looks busier than a full one. #}
										{% if shown is empty %}
											<span class="text-body-secondary">—</span>
										{% elseif file %}
											<a href="{{ path('record_file', {module: module.key, id: record.id, field: field.key}) }}">{{ file.name }}</a>
											<span class="text-body-secondary">{{ file_size(file.size) }}</span>
										{% elseif badge %}
											{{ include('_value_badge.html.twig', {badge: badge}) }}
										{% else %}
											{{ link.linked(field, record.get(field.key), shown) }}
										{% endif %}
									</dd>
								{% endif %}
							{% endfor %}
						</dl>
						{% endfor %}

						{# A section of the record, not a card beside it: an address belongs
						   to this contact rather than sitting next to it (§5.1). #}
						{% for collection in module.collections %}
							{% set rows = children[collection.key] %}

							<h2 class="h6 text-uppercase text-body-secondary border-top pt-3 mt-4">{{ collection.label }}</h2>

							{% if rows is empty %}
								<p class="text-body-secondary mb-0">{{ 'common.none'|trans }}</p>
							{% else %}
								<div class="table-responsive">
									<table class="table table-sm align-middle mb-0">
										<thead>
											<tr>
												{% for field in collection.fields %}
													<th scope="col" class="text-body-secondary small text-uppercase fw-normal">{{ field.label }}</th>
												{% endfor %}
											</tr>
										</thead>
										<tbody>
											{% for row in rows %}
												{# What this row has taken from elsewhere and since diverged from
												   (XIV-18). Said on the row rather than in a footnote, because the
												   question it answers — "is this price negotiated or stale?" — is
												   asked while looking at the row. #}
												{% set apart = drifted[collection.key][row.id]|default([]) %}
												{# What nothing has taken yet (XIV-19): an order line
												   half invoiced says so on the line, where somebody
												   deciding what to invoice next is looking. #}
												{% set remaining = outstanding[collection.key]|default(null) %}
												{% set left = remaining ? remaining.rows[row.id]|default(null) : null %}
												<tr>
													{% for field in collection.fields %}
														{#
															No `formatted()` here, and that is the decision rather
															than an oversight (XIV-131, §5.21). A collection row is a
															table row, and a table cell has no room for blocks: a
															heading and a two-item list dropped into one make the row
															four lines tall and the column beside it unreadable. So a
															cell gets `display()`, which for a formatted field is the
															words with the marks taken off — `Warning: do not…` rather
															than `**Warning:** do not…` — for the same reason a list
															column and a Word document get it.
														#}
														{% set shown = display(field, row.get(field.key)) %}
														{# A collection's fields point at shared lists exactly as a
														   module's do — a collection is a shape (§5.1) — so the chip
														   is drawn here too. It is the same reason the merge counts
														   collection rows: half of somebody's data saying "Zurich"
														   for ever would be the worst possible outcome. #}
														{% set badge = value_badge(field, row.get(field.key)) %}
														<td>
															{% if shown is empty %}
																<span class="text-body-secondary">—</span>
															{% elseif badge %}
																{{ include('_value_badge.html.twig', {badge: badge}) }}
															{% else %}
																{{ link.linked(field, row.get(field.key), shown) }}
															{% endif %}
															{% if field.label in apart %}
																<i class="bi bi-pencil-square text-body-secondary small"
																   title="{{ 'module.drifted'|trans({'%field%': field.label}) }}"
																   aria-hidden="true"></i>
															{% endif %}
															{% if left is not null and field.key == remaining.field %}
																<span class="badge text-bg-light ms-1"
																      title="{{ 'module.outstanding_help'|trans }}">
																	{{ 'module.outstanding'|trans({'%amount%': left}) }}
																</span>
															{% endif %}
														</td>
													{% endfor %}
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>

				{#
					Records pointing at this one (§7.6) — a company's people. Read from
					the reference on their side rather than stored here, so the two can
					never disagree about who works where.

					**Inside the main column, not beside it.** These used to be cards of
					their own in the row, and the grid lays a row out in order: the
					sidebar came after them, so it settled next to the *last* of these
					with a hole above it wherever there was more than one.
				#}
				{% for group in linked %}
					{# The heading names the field as well only when one module points
					   here twice — "Orders" beats "Orders: Contact" and says the same. #}
					{% set twice = linked|filter(g => g.module.key == group.module.key)|length > 1 %}

					<div class="card mt-3">
						<div class="card-body">
							{# Closed by default: a contact with forty invoices is a page you
							   scroll past to reach anything else, and the heading and the
							   count are the part somebody came to read. Native <details>
							   rather than a Bootstrap collapse, the same choice the timeline
							   made (XIV-3) — no JavaScript, and it opens with the keyboard.

							   The heading stays an <h2> inside the summary, which is the one
							   thing summary's content model allows besides phrasing content,
							   so this is still a document with headings in it. #}
							<details class="linked-group">
								<summary>
									<h2 class="h6 text-uppercase text-body-secondary d-inline mb-0">
										{{ group.heading(twice) }}
										{# How many there are, not how many fit: the card is capped,
										   and the length of the list below it is a fact about the
										   cap rather than about the customer (XIV-52). #}
										<span class="badge text-bg-light fw-normal">{{ group.total }}</span>
									</h2>
								</summary>
								<ul class="list-unstyled mb-0 mt-3">
									{% for linkedRecord in group.records %}
										<li class="{{ loop.first ? '' : 'border-top pt-2 mt-2' }}">
											{# The other module's own page, and its own way of naming a
											   record — this one may be a different module entirely. #}
											<a href="{{ path('module_show', {module: group.module.key, id: linkedRecord.id}) }}">
												{{ record_title(group.module, linkedRecord.data, linkedRecord.id) }}
											</a>
										</li>
									{% endfor %}
								</ul>

								{# Said only when something is missing — "showing 3 of 3" is noise.
								   The way to the rest is the other module's own list, filtered to
								   this record (XIV-13), offered only to somebody allowed to open
								   it: a link to a 403 is worse than no link. The sentence stands
								   either way, because how many are missing is worth knowing even
								   when you cannot go and read them. #}
								{% if group.isTruncated %}
									<p class="small text-body-secondary mb-0 mt-3">
										{{ 'module.linked_shown'|trans({'%shown%': group.shown, '%total%': group.total}) }}
										{% if can('list', group.module) %}
											<a href="{{ path('module_index', group.listing) }}">{{ 'module.linked_all'|trans }}</a>
										{% endif %}
									</p>
								{% endif %}
							</details>
						</div>
					</div>
				{% endfor %}

			</div>

			<div class="col-lg-4">
				<div class="card mb-3">
					<div class="card-body">
						<h2 class="h6 text-uppercase text-body-secondary mb-3">{{ 'module.record'|trans }}</h2>
						<dl class="row small mb-0">
							<dt class="col-5 fw-normal text-body-secondary">{{ 'module.owner'|trans }}</dt>
							<dd class="col-7">{{ owner ?? '—' }}</dd>
							{% if record.createdAt %}
								<dt class="col-5 fw-normal text-body-secondary">{{ 'module.created'|trans }}</dt>
								<dd class="col-7">{{ record.createdAt|date('Y-m-d H:i') }}</dd>
							{% endif %}
							{% if record.updatedAt %}
								<dt class="col-5 fw-normal text-body-secondary">{{ 'module.changed'|trans }}</dt>
								<dd class="col-7 mb-0">{{ record.updatedAt|date('Y-m-d H:i') }}</dd>
							{% endif %}
						</dl>
					</div>
				</div>

				{#
					What a number on this record has been worth over time (XIV-121).

					**Above the timeline and below the record's own facts**, which is
					where a trend belongs: it is read about the record rather than
					looked up on it, so it is context in the right-hand column like the
					history card — but it is a summary of many entries, and a summary
					reads before the entries it summarises rather than after them.

					Mounted unconditionally and the card decides whether it exists,
					which is the opposite of what the follow-up panel above does. The
					difference is what the question costs: whether a module takes
					follow-ups is a flag on the definition, so the page can ask it for
					free, while whether this record has anything numeric to draw is a
					fact about its own history. Asking here would mean the controller
					building the trends to decide whether to mount the component that
					builds the trends. The component answers it from its definitions
					before it queries anything, so a contact page pays a construction
					and no round trip.
				#}
				<twig:RecordTrend module="{{ module.key }}" :recordId="record.id" />

				{# History belongs on the record, not on the form: it is something you
				   read about a record, not something you edit (§5.2). The latest few
				   of it, at least — the whole timeline has a page of its own, so this
				   card is the same height on a record edited once and one edited every
				   day for a year (XIV-3). #}
				<div class="card">
					<div class="card-body">
						<h2 class="h6 text-uppercase text-body-secondary mb-3">{{ 'module.history'|trans }}</h2>

						{% if history is empty %}
							<p class="text-body-secondary small mb-0">
								{{ 'module.history_empty'|trans }}
							</p>
						{% else %}
							{{ h.entries(module, history) }}

							{# Said whenever there is more, and it says how much more: a
							   list that silently stopped at five is a list that lies. #}
							{% if historyTotal > historyShown %}
								<a class="small d-inline-block mt-3"
								   href="{{ path('module_history', {module: module.key, id: record.id}) }}">
									{{ 'module.history_all'|trans({'%count%': historyTotal}) }}
								</a>
							{% endif %}
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</main>

	{#
		The chooser, as a modal (XIV-4). Its contents are the same form the page at
		module_document_choose renders, so there is one description of what
		"generate a document" asks for — and the link above still goes to that page
		when Bootstrap's JavaScript is not there to intercept it.
	#}
	{% if documents is not empty %}
		<div class="modal fade" id="document-modal" tabindex="-1" aria-labelledby="document-modal-title" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h2 class="modal-title h5" id="document-modal-title">{{ 'document.documents'|trans }}</h2>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'common.cancel'|trans }}"></button>
					</div>
					<div class="modal-body">
						{{ include('document/_choose.html.twig', {templates: documents, formats: formats, decorations: decorations, id: 'modal'}) }}
					</div>
				</div>
			</div>
		</div>
	{% endif %}

	{#
		The send chooser, as a modal (XIV-39) — the same arrangement the document
		one above uses, and the same reason: its contents are the very form the page
		at module_email_choose renders, so there is one description of what a send
		asks for, and the link still leads to that page when Bootstrap's JavaScript
		is not there to intercept it.
	#}
	{% if emails.templates is not empty and emails.recipient.resolved %}
		<div class="modal fade" id="email-modal" tabindex="-1" aria-labelledby="email-modal-title" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h2 class="modal-title h5" id="email-modal-title">{{ 'mail.send_email'|trans }}</h2>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'common.cancel'|trans }}"></button>
					</div>
					<div class="modal-body">
						{{ include('mail/_choose.html.twig', {
							templates: emails.templates,
							recipient: emails.recipient,
							draft: emails.draft,
							attachments: emails.attachments,
							formats: formats,
