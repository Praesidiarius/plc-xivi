{% extends 'base.html.twig' %}

{% import _self as h %}

{#
	One stored value, rendered as the field it describes.

	History keeps values in storage form and carries the label it had at the time
	(§5.2), so an entry stays readable after the field is renamed — and after it is
	deleted, when there is no definition left to ask. That is the fallback here:
	the type formats it when the field still exists, and the raw stored value shows
	when it does not.
#}
{% macro value(shape, key, stored) %}
	{%- set field = shape ? shape.getField(key) : null -%}
	{%- if stored is null -%}
		<span class="text-body-secondary">empty</span>
	{%- elseif field -%}
		{{ display_stored(field, stored) }}
	{%- else -%}
		{{ stored }}
	{%- endif -%}
{% endmacro %}

{% block title %}{{ record.isNew ? 'New' : 'Edit' }} — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ record.isNew ? 'New' : 'Edit' }} {{ module.label|lower }}</h1>
			<a class="btn btn-link" href="{{ path('module_index', {module: module.key}) }}">Back</a>
		</div>

		{{ form_start(form) }}
		{{ form_errors(form) }}

		<div class="card">
			<div class="card-body">
				{# Every field here came from a definition row — including any the
				   customer added themselves, which is the point. #}
				{{ form_widget(form.fields) }}
			</div>
		</div>

		{# And every one of these came from the same kind of row, on a shape that
		   happens to be a collection rather than a module. #}
		{% for collection in module.collections %}
			{% set entries = form.collections[collection.key] %}

			<div class="card mt-3">
				<div class="card-body">
					<h2 class="h5 mb-3">{{ collection.label }}</h2>

					<div data-collection
						 data-prototype="{{ form_widget(entries.vars.prototype)|e('html_attr') }}"
						 data-next-index="{{ entries|length }}">
						{% for entry in entries %}
							<div class="row-of-collection border-top pt-3 mt-3">
								{{ form_widget(entry) }}
								<button type="button" class="btn btn-outline-danger btn-sm" data-collection-remove>Remove</button>
							</div>
						{% endfor %}
					</div>

					{# Scripting only adds convenience: without it the blank row at
					   the bottom still takes one more, and clearing a row's fields
					   still removes it, because an empty row is not saved. #}
					<button type="button" class="btn btn-outline-secondary btn-sm mt-3" data-collection-add hidden>
						Add {{ collection.label|lower }}
					</button>
				</div>
			</div>
		{% endfor %}

		<div class="d-flex align-items-center gap-3 mt-4">
			<button type="submit" class="btn btn-primary">Save</button>
			{% if not record.isNew and record.createdAt %}
				<span class="text-body-secondary small">Created {{ record.createdAt|date('Y-m-d H:i') }}</span>
			{% endif %}
		</div>
		{# Everything above is rendered by hand, so form_rest would only re-emit the
		   collection containers as empty wrappers. The token is the one thing it
		   would otherwise have added, so it is added here instead. #}
		{% if form.children._token is defined %}{{ form_widget(form._token) }}{% endif %}
		{{ form_end(form, {render_rest: false}) }}

		{% if history is not empty %}
			<div class="card mt-3">
				<div class="card-body">
					<h2 class="h5 mb-3">History</h2>

					<ul class="list-unstyled mb-0">
						{% for entry in history %}
							<li class="border-top pt-3 mt-3">
								<div class="d-flex justify-content-between align-items-baseline gap-3">
									<span>
										<strong>{{ entry.action.value|capitalize }}</strong>
										{# Nobody signed in is an import or a console command, not a gap. #}
										by {{ entry.userLabel ?? 'System' }}
									</span>
									<time class="text-body-secondary small text-nowrap"
										  datetime="{{ entry.occurredAt|date('c') }}">
										{{ entry.occurredAt|date('Y-m-d H:i') }}
									</time>
								</div>

								<ul class="small text-body-secondary mt-2 mb-0">
									{# Ordered by the definitions, because jsonb does not keep
									   the order these were written in. #}
									{% for key, change in in_field_order(module, entry.fieldChanges) %}
										<li>
											{{ change.label }}:
											{{ h.value(module, key, change.from) }} → {{ h.value(module, key, change.to) }}
										</li>
									{% endfor %}

									{% for collectionKey, rows in entry.collectionChanges %}
										{% set collection = module.getCollection(collectionKey) %}
										{% for row in rows %}
											<li>
												{{ collection ? collection.label : collectionKey }} {{ row.action }}:
												{% if row.action == 'updated' %}
													{% for key, change in in_field_order(collection, row.changes) %}
														{{ change.label }}
														{{ h.value(collection, key, change.from) }} → {{ h.value(collection, key, change.to) }}{{ loop.last ? '' : ',' }}
													{% endfor %}
												{% else %}
													{% for key, held in in_field_order(collection, row.values) %}
														{{ h.value(collection, key, held.value) }}{{ loop.last ? '' : ',' }}
													{% endfor %}
												{% endif %}
											</li>
										{% endfor %}
									{% endfor %}
								</ul>
							</li>
						{% endfor %}
					</ul>
				</div>
			</div>
		{% endif %}
	</main>
{% endblock %}
