{% extends 'base.html.twig' %}

{% block title %}{{ record.isNew ? 'New' : 'Edit' }} — {{ module.label }}{% endblock %}

{% block body %}
	<div class="shell">
		{{ include('_topbar.html.twig') }}

		<div class="page-head">
			<h1>{{ record.isNew ? 'New' : 'Edit' }} {{ module.label|lower }}</h1>
			<a href="{{ path('module_index', {module: module.key}) }}">Back</a>
		</div>

		{{ include('_flashes.html.twig') }}

		<div class="card wide">
			{# Every field here came from a definition row — including any the
			   customer added themselves, which is the point. #}
			{{ form_start(form) }}
			{{ form_errors(form) }}
			{{ form_widget(form) }}

			<div class="form-actions">
				<button type="submit">Save</button>
				{% if not record.isNew %}
					<span class="muted">Created {{ record.createdAt ? record.createdAt|date('Y-m-d H:i') : '' }}</span>
				{% endif %}
			</div>
			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
