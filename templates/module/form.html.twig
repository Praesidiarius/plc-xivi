{% extends 'base.html.twig' %}

{% block title %}{{ (record.isNew ? 'common.new' : 'common.edit')|trans }} — {{ module.label }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ (record.isNew ? 'module.new_title' : 'module.edit_title')|trans({'%module%': module.label|lower}) }}</h1>
			{# Back to wherever you came from: the record being edited, or the list
			   when there is no record yet. #}
			<a class="btn btn-link" href="{{ record.isNew
				? path('module_index', {module: module.key})
				: path('module_show', {module: module.key, id: record.id}) }}">{{ 'common.back'|trans }}</a>
		</div>

		{#
			The whole form is a Live Component (XIV-33). The page hands it scalars
			and it builds the rest itself — the form, the row buttons and the save
			— which is the shape the library documents and the reason the
			controller no longer takes a POST here.
		#}
		<twig:RecordForm
			module="{{ module.key }}"
			:recordId="record.id"
			:variant="module.variantOf(record.data)"
			:seeded="seeded|default({})"
			:seededFields="seededFields|default({})"
		/>
	</main>
{% endblock %}
