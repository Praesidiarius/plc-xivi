{# No dismiss buttons. Bootstrap's JavaScript is shipped now (for tooltips,
   XIV-8), so they would work — they are simply not wanted: a message worth
   showing is worth reading, and one worth dismissing should not have been a
   message. #}
{% set styles = {success: 'success', warning: 'warning', error: 'danger'} %}

{% for type, messages in app.flashes(styles|keys) %}
	{% for message in messages %}
		<div class="alert alert-{{ styles[type] }}" role="status">{{ message }}</div>
	{% endfor %}
{% endfor %}
