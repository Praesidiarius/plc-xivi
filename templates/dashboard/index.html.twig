{% extends 'base.html.twig' %}

{% block title %}{{ tenant.name }}{% endblock %}

{% block body %}
	<div class="shell">
		{{ include('_topbar.html.twig') }}

		{{ include('_flashes.html.twig') }}

		<h1>{{ tenant.name }}</h1>

		{% if chrome.modules is empty %}
			<p class="muted">
				No modules installed yet. Install one with
				<code>bin/console tenant:module:install {{ tenant.slug }} contact</code>.
			</p>
		{% else %}
			<div class="tiles">
				{% for module in chrome.modules %}
					<a class="tile" href="{{ path('module_index', {module: module.key}) }}">
						<strong>{{ module.label }}</strong>
						<span class="muted">{{ module.fields|length }} fields</span>
					</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
{% endblock %}
