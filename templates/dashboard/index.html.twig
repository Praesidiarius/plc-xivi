{% extends 'base.html.twig' %}

{% block title %}{{ tenant.name }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-4">{{ tenant.name }}</h1>

		{#
			The page is its widgets and nothing else (XIV-81). What used to be here
			— a tile grid and two empty states — is `dashboard/widget/modules.html.twig`
			now, which is what makes follow-ups *a* widget rather than the one thing
			that got special treatment. Anything the landing page grows next is a
			class implementing DashboardWidget and a template of its own; this file
			does not change again.

			Ordering is the tag priority on each widget, already applied by the time
			the panels arrive, so there is nothing to sort and nothing here that
			knows which widget is which.

			`only`, so a panel is rendered with exactly what its widget handed over
			and cannot quietly start depending on a variable that happens to be in
			scope on this page. The globals every template has — `chrome`, `app` —
			are unaffected.
		#}
		{% for panel in panels %}
			<section class="mb-4">
				{% if panel.titleKey %}
					<h2 class="h5 mb-3">{{ panel.titleKey|trans }}</h2>
				{% endif %}

				{{ include(panel.template, panel.data, with_context = false) }}
			</section>
		{% endfor %}
	</main>
{% endblock %}
