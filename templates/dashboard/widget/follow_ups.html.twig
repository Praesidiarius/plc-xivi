{#
	What is on this person's list and wants doing (XIV-81).

	Every moment here goes through `|date`, which converts into the reader's zone
	before formatting because a request-scoped listener sets Twig's timezone
	(§8.4.4). The *boundaries* that decided which follow-ups are on this list were
	drawn in PHP, in the same zone, before this template ran — see FollowUpLens.

	`datetime="…|date('c')"` on the <time> element carries the offset, so what the
	page says and what a machine reads cannot disagree.
#}
{% set now = date() %}

{#
	How loudly each priority is drawn. Here rather than on FollowUpPriority
	because `text-bg-*` is Bootstrap's vocabulary and the enum is what the
	database holds — the same split ModuleAction makes when it hands out a label
	*key* instead of a label. The enum's own docblock says as much.
#}
{% set priorityStyles = {'info': 'secondary', 'warning': 'warning', 'important': 'danger'} %}

<div class="card">
	<div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
		{#
			Three links, no JavaScript. A GET that changes what a page shows is a
			GET, and the lens is named by the widget rather than called something
			generic so that a second widget with a control cannot move this one.

			`app.request.query.all|merge(...)` keeps whatever else is on the URL,
			which costs nothing now and is what stops the next widget's parameter
			from being wiped by a click on this one.
		#}
		<div class="btn-group btn-group-sm" role="group" aria-label="{{ 'follow_up.lens_group'|trans }}">
			{% for option in lenses %}
				<a class="btn btn-outline-secondary{{ option == lens ? ' active' : '' }}"
				   {% if option == lens %}aria-current="true"{% endif %}
				   href="{{ path('dashboard', app.request.query.all|merge({(parameter): option.value})) }}">
					{{ option.labelKey|trans }}
				</a>
			{% endfor %}
		</div>
	</div>

	{% if entries is empty %}
		{#
			An empty lens is information rather than a reason to hide: "nothing due
			this week" is the good news this widget exists to be able to deliver,
			and the sentence is per lens because "nothing at all" and "nothing yet"
			are different things to be told.
		#}
		<div class="card-body text-body-secondary mb-0">
			{{ lens.emptyKey|trans }}
		</div>
	{% else %}
		<ul class="list-group list-group-flush">
			{% for entry in entries %}
				{% set followUp = entry.followUp %}
				{% set overdue = followUp.dueAt < now %}

				<li class="list-group-item d-flex flex-wrap gap-2 justify-content-between align-items-start">
					<div class="me-auto">
						{#
							What the follow-up says. Its opening note is its text — a
							priority and a date on their own describe nothing — and it
							is the half that stays when the record does not.
						#}
						{% if entry.openingNote %}
							<div>{{ entry.openingNote.body }}</div>
						{% endif %}

						<div class="small text-body-secondary">
							{#
								Named and linked where the reader may open it; silent
								where they may not. That is the same split XIV-42 made
								between a reference's name and a link to it, and the
								record is *absent* rather than shown unlinked because
								nothing about it has been disclosed yet: they keep the
								work they were given and do not learn what it is
								attached to (§5.18).

								A follow-up on a deleted record is not this case and is
								not here at all — the repository excluded it.
							#}
							{% if entry.namesItsRecord %}
								<a href="{{ path('module_show', {module: entry.module.key, id: entry.record.id}) }}">
									{{- record_title(entry.module, entry.record.data, entry.record.id) -}}
								</a>
								<span class="mx-1">·</span>
							{% endif %}

							<span class="badge text-bg-{{ priorityStyles[followUp.priority.value] }}">
								{{ followUp.priority.labelKey|trans }}
							</span>
						</div>
					</div>

					{#
						Overdue is read rather than stored, exactly as an invoice's
						lateness is (§5.16) — and unlike an invoice it is still on this
						list, because the lenses bound only the far end. A follow-up
						somebody missed stays where they will see it.
					#}
					<time class="text-nowrap small{{ overdue ? ' text-danger fw-semibold' : ' text-body-secondary' }}"
					      datetime="{{ followUp.dueAt|date('c') }}">
						{{- followUp.dueAt|date('Y-m-d H:i') -}}
					</time>
				</li>
			{% endfor %}
		</ul>

		{% if more > 0 %}
			{#
				The cap is the widget's and is said out loud. A summary that quietly
				stopped at ten would be a summary somebody trusted to be complete.
			#}
			<div class="card-footer text-body-secondary small">
				{{ 'follow_up.more_due'|trans({'%count%': more}) }}
			</div>
		{% endif %}
	{% endif %}
</div>
