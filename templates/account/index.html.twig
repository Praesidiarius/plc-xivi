{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">{{ 'account.title'|trans }}</h1>

		{#
			The hold, explained rather than merely enforced: somebody bounced back
			here from every link they click deserves to know why, and the reason is
			a good one (§8.5).
		#}
		{% if held %}
			<div class="alert alert-warning">
				<h2 class="h6">{{ 'account.hold_title'|trans }}</h2>
				<p class="mb-0">
					{{ 'account.hold_body'|trans }}
				</p>
			</div>
		{% endif %}

		<div class="row g-3">
			<div class="col-12 col-lg-6">
				<form method="post" class="card h-100">
					<div class="card-body">
						<h2 class="h6">{{ 'account.details'|trans }}</h2>
						<input type="hidden" name="_token" value="{{ csrf_token('account') }}">
						<input type="hidden" name="action" value="details">

						<div class="mb-3">
							<label class="form-label" for="name">{{ 'common.name'|trans }}</label>
							<input class="form-control" type="text" id="name" name="name" value="{{ account.name }}">
							<div class="form-text">{{ 'account.name_help'|trans }}</div>
						</div>

						<div class="mb-3">
							<label class="form-label" for="email">{{ 'common.email'|trans }}</label>
							<input class="form-control" type="email" id="email" value="{{ account.email }}" disabled>
							{#
								Read-only here on purpose: it is the login and the identifier the
								session holds, so changing it under your own session signs you out.
								An administrator does it from the users page.
							#}
							<div class="form-text">{{ 'account.email_help'|trans }}</div>
						</div>

						<button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button>
					</div>
				</form>
			</div>

			<div class="col-12 col-lg-6">
				<form method="post" class="card h-100">
					<div class="card-body">
						<h2 class="h6">{{ 'common.password'|trans }}</h2>
						<input type="hidden" name="_token" value="{{ csrf_token('account') }}">
						<input type="hidden" name="action" value="password">

						<div class="mb-3">
							<label class="form-label" for="current_password">{{ 'account.current_password'|trans }}</label>
							<input class="form-control" type="password" id="current_password"
								   name="current_password" autocomplete="current-password" required>
							<div class="form-text">
								{{ 'account.current_password_help'|trans }}
							</div>
						</div>

						<div class="mb-3">
							<label class="form-label" for="new_password">{{ 'account.new_password'|trans }}</label>
							<input class="form-control" type="password" id="new_password" name="new_password"
								   autocomplete="new-password" minlength="{{ minimum }}" required>
							<div class="form-text">{{ 'account.password_minimum'|trans({'%count%': minimum}) }}</div>
						</div>

						<div class="mb-3">
							<label class="form-label" for="repeat_password">{{ 'account.repeat_password'|trans }}</label>
							<input class="form-control" type="password" id="repeat_password" name="repeat_password"
								   autocomplete="new-password" minlength="{{ minimum }}" required>
						</div>

						<button class="btn btn-primary" type="submit">{{ 'account.change_password'|trans }}</button>
					</div>
				</form>
			</div>
		</div>

		{#
			Its own form, because it is its own decision: changing your language
			should not require typing your current password, and saving a password
			should not quietly change your language.
		#}
		<div class="card mt-4">
			<div class="card-body">
				<h2 class="h5 mb-3">{{ 'account.language'|trans }}</h2>

				<form method="post">
					<input type="hidden" name="_token" value="{{ csrf_token('account') }}">
					<input type="hidden" name="action" value="language">

					<div class="mb-3">
						<label class="form-label" for="locale">{{ 'account.language'|trans }}</label>
						<select class="form-select" id="locale" name="locale">
							{% for value, label in locales %}
								<option value="{{ value }}" {{ account.locale|default('') == value ? 'selected' : '' }}>
									{{ label }}
								</option>
							{% endfor %}
						</select>
						<div class="form-text">{{ 'account.language_help'|trans }}</div>
					</div>

					{# The other half of the same question (XIV-50): the language
					   decides the words, this decides how a number and a date are
					   written. Swiss German and German German are one catalogue
					   and two ways of writing a figure. #}
					<div class="mb-3">
						<label class="form-label" for="region">{{ 'account.region'|trans }}</label>
						<select class="form-select" id="region" name="region">
							<option value="">{{ 'account.region_default'|trans }}</option>
							{% for code, name in regions %}
								<option value="{{ code }}" {{ account.region|default('') == code ? 'selected' : '' }}>
									{{ name }}
								</option>
							{% endfor %}
						</select>
						<div class="form-text">{{ 'account.region_help'|trans }}</div>
					</div>

					<button class="btn btn-primary" type="submit">{{ 'account.save_language'|trans }}</button>
				</form>
			</div>
		</div>
	</main>
{% endblock %}
