{#
	The whole record form as a Live Component — the documented shape.

	Everything is an action: adding a row, removing one, and saving. Note what is
	not here — no route, no method, no target, no swap. The component re-renders
	itself entire after each one and the library works out the difference.

	The `<form>` element is still a form, but nothing ever posts it: `live#action`
	on submit intercepts, and `:prevent` stops the browser doing it as well.

	There is no `data-model` here and there should not be: the component puts it
	on the form itself, which is what makes the totals follow the typing
	(XIV-32) — see `RecordForm::getDataModelValue()`. The component morphs the
	changed nodes rather than replacing the region, so the field somebody is
	typing in keeps its caret; replacing it would take the caret with it,
	mid-number, which is the thing this mechanism was chosen for.
#}
<div{{ attributes }}>
	{{ form_start(form, {attr: {
		'data-action': 'live#action:prevent',
		'data-live-action-param': 'save',
	}}) }}
	{{ form_errors(form) }}

	<div class="card">
		<div class="card-body">
			{#
				Every field here came from a definition row — including any the
				customer added themselves, which is the point.

				Each field carries its own `col-*` (XIV-43) and the container it sits
				in *is* the grid row — see RecordType, which puts the class on the
				form's own container rather than here, so it holds for a collection
				row's fields too. Nothing here knows what a field is.

				**Two calls, and the first one is the one that matters** (XIV-119). A
				module with no sections — which is every module in every tenant until
				somebody makes one — takes the branch this form has always taken,
				`form_widget(form.fields)`, unchanged and unconditional. That is not
				an optimisation and it is not a coincidence of output: "an existing
				definition draws exactly as it does today" is a promise, and the way
				to keep a promise like that is to run the same line of code rather
				than a second one believed to produce the same bytes.

				The other branch draws the runs `ModuleDefinition::getFieldGroupsFor()`
				hands over — the ungrouped fields first, then a heading and its fields
				for each section. The record page reads the same method, which is what
				stops the two disagreeing.
			#}
			{% set groups = this.fieldGroups %}

			{% if groups|filter(g => g.section is not null) is empty %}
				{{ form_widget(form.fields) }}
			{% else %}
				{% for group in groups %}
					{% if group.section %}
						{# The customer's own word, not a translation key — the same
						   thing a field's label is, and handled the same way (§5.4). #}
						<h2 class="h6 text-uppercase text-body-secondary {{ loop.first ? '' : 'border-top pt-3 mt-4' }}">{{ group.section.label }}</h2>
					{% endif %}
					<div class="row">
						{% for field in group.fields %}
							{% if form.fields.children[field.key] is defined %}
								{{ form_row(form.fields.children[field.key]) }}
							{% endif %}
						{% endfor %}
					</div>
				{% endfor %}
				{# Nothing, on every request this has ever served: the groups are built
				   from the very method the form's fields are, so the two sets are the
				   same set. It is here because the failure if they ever stopped being
				   the same set is a control that silently vanishes and takes its value
				   with it on the next save, and a stray row is a far better way to
				   find that out. #}
				{{ form_rest(form.fields) }}
			{% endif %}
		</div>
	</div>

	{# Which kind of row the engine writes for itself (XIV-104), so that the two
	   things a person could do to one are not offered: its controls are drawn
	   disabled by the form itself, and the button below that would delete it is
	   not drawn at all. Neither is the enforcement — the deriver writes these rows
	   from the voucher on every save, so a request that edits or deletes one
	   changes nothing — but a button that promises something the save undoes is
	   worse than no button. #}
	{% set generated = this.generatedKind(this.moduleDefinition) %}

	{% for collection in this.moduleDefinition.collections|filter(c => not c.derived) %}
		{% set entries = form.collections[collection.key] %}

		<div class="card mt-3">
			<div class="card-body">
				<h2 class="h5 mb-3">{{ collection.label }}</h2>

				{% for entry in entries %}
					{% set kind = collection.hasVariants ? entry.vars.data.fields[collection.variantField]|default(null) : null %}
					<div class="row-of-collection border-top pt-3 mt-3">
						{# Where the row sits (XIV-21): type 15 to put something between
						   10 and 20, and the save renumbers everything in tens again. #}
						<div class="row-position-cell">
							{{ form_widget(entry.position, {attr: {class: 'form-control form-control-sm'}}) }}
						</div>
						{# A row's kind is fixed once it exists (XIV-20), so it is a
						   heading rather than a control. #}
						{% if kind %}
							<h3 class="h6 text-body-secondary">{{ collection.getVariants[kind]|default(kind) }}</h3>
						{% endif %}
						{{ form_widget(entry) }}

						{% if kind is null or kind != generated %}
							<button type="button" class="btn btn-outline-danger btn-sm"
							        data-action="live#action"
							        data-live-action-param="removeRow"
							        data-live-collection-param="{{ collection.key }}"
							        data-live-index-param="{{ loop.index0 }}">
								{{ 'common.remove'|trans }}
							</button>
						{% endif %}
					</div>
				{% endfor %}

				{# One button per kind, and only the kinds this customer can fill in
				   (XIV-23). #}
				<div class="d-flex flex-wrap gap-2 mt-3">
					{% for kind, label in this.kinds[collection.key]|default({}) %}
						<button type="button" class="btn btn-outline-secondary btn-sm"
						        data-action="live#action"
						        data-live-action-param="addRow"
						        data-live-collection-param="{{ collection.key }}"
						        data-live-kind-param="{{ kind }}">
							{{ 'module.add_kind'|trans({'%kind%': label}) }}
						</button>
					{% endfor %}

					{% if this.kinds[collection.key]|default({}) is empty %}
						<button type="button" class="btn btn-outline-secondary btn-sm"
						        data-action="live#action"
						        data-live-action-param="addRow"
						        data-live-collection-param="{{ collection.key }}"
						        data-live-kind-param="">
							{{ 'module.add_row'|trans({'%collection%': collection.label|lower}) }}
						</button>
					{% endif %}
				</div>
			</div>
		</div>
	{% endfor %}

	<div class="d-flex align-items-center gap-3 mt-4">
		<button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
		{% if not this.record.isNew and this.record.createdAt %}
			<span class="text-body-secondary small">{{ 'module.created_at'|trans({'%when%': this.record.createdAt|date('Y-m-d H:i')}) }}</span>
		{% endif %}
	</div>
	{% if form.children._token is defined %}{{ form_widget(form._token) }}{% endif %}
	{{ form_end(form, {render_rest: false}) }}
</div>
