{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		{#
			Generated passwords are shown here and nowhere else, ever again. Given
			their own style so they cannot be mistaken for an ordinary "saved"
			message and clicked past (§8.5).
		#}
		{% for message in app.flashes('password') %}
			<div class="alert alert-warning d-flex align-items-start gap-2">
				<i class="bi bi-key" aria-hidden="true"></i>
				<span>{{ message }}</span>
			</div>
		{% endfor %}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">Users</h1>
			<div class="d-flex gap-2">
				<a class="btn btn-outline-secondary" href="{{ path('group_index') }}">
					<i class="bi bi-shield-lock" aria-hidden="true"></i> Permission groups
				</a>
				<a class="btn btn-primary" href="{{ path('user_new') }}">
					<i class="bi bi-person-plus" aria-hidden="true"></i> Add user
				</a>
			</div>
		</div>

		<div class="table-responsive">
			<table class="table align-middle">
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Email</th>
						<th scope="col">Role</th>
						<th scope="col">Last signed in</th>
						<th scope="col"><span class="visually-hidden">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						<tr class="{{ user.active ? '' : 'text-body-secondary' }}">
							<td>
								{{ user.name }}
								{% if user.id == app.user.id %}
									<span class="badge text-bg-light">you</span>
								{% endif %}
								{% if not user.active %}
									<span class="badge text-bg-secondary">deactivated</span>
								{% endif %}
								{#
									Worth showing: it means the password you handed them is still
									the one in use, so it is still a credential two people know.
								#}
								{% if user.mustChangePassword %}
									<span class="badge text-bg-light">password not set yet</span>
								{% endif %}
							</td>
							<td>{{ user.email }}</td>
							<td>{{ 'ROLE_ADMIN' in user.roles ? 'Administrator' : 'Member' }}</td>
							<td>
								{{ user.lastLoginAt ? user.lastLoginAt|date('Y-m-d H:i') : 'never' }}
							</td>
							<td class="text-end">
								<div class="d-inline-flex gap-1">
									<a class="btn btn-sm btn-outline-secondary" href="{{ path('user_edit', {id: user.id}) }}">
										<i class="bi bi-pencil" aria-hidden="true"></i>
										<span class="visually-hidden">Edit {{ user.email }}</span>
									</a>

									<form method="post" action="{{ path('user_password', {id: user.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">
										<button class="btn btn-sm btn-outline-secondary" type="submit">
											<i class="bi bi-key" aria-hidden="true"></i>
											<span class="visually-hidden">Reset the password of {{ user.email }}</span>
										</button>
									</form>

									{#
										No delete button anywhere on this page. Records carry the id of
										whoever owns them and history carries the id of whoever made each
										change, so a deleted row leaves records belonging to nobody.
										Deactivating locks the person out and keeps all of it readable.
									#}
									<form method="post" action="{{ path('user_active', {id: user.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">
										<input type="hidden" name="active" value="{{ user.active ? '0' : '1' }}">
										<button class="btn btn-sm btn-outline-secondary" type="submit">
											<i class="bi bi-{{ user.active ? 'person-slash' : 'person-check' }}" aria-hidden="true"></i>
											<span class="visually-hidden">
												{{ user.active ? 'Deactivate' : 'Reactivate' }} {{ user.email }}
											</span>
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		{#
			Said on the list rather than only on the groups screen, because the
			question it answers — "why can my new colleague not see anything" —
			is one somebody asks while looking at this page.
		#}
		<p class="text-body-secondary small mb-0">
			Administrators may do everything. Everybody else starts with nothing and gets
			what their <a href="{{ path('group_index') }}">permission groups</a> give them,
			per module and per action.
		</p>
	</main>
{% endblock %}
