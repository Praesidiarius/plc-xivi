{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		{#
			Generated passwords are shown here and nowhere else, ever again. Given
			their own style so they cannot be mistaken for an ordinary "saved"
			message and clicked past (§8.5).
		#}
		{% for message in app.flashes('password') %}
			<div class="alert alert-warning d-flex align-items-start gap-2">
				<i class="bi bi-key" aria-hidden="true"></i>
				<span>{{ message }}</span>
			</div>
		{% endfor %}

		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h3 mb-0">{{ 'nav.users'|trans }}</h1>
			<div class="d-flex gap-2">
				<a class="btn btn-outline-secondary" href="{{ path('group_index') }}">
					<i class="bi bi-shield-lock" aria-hidden="true"></i> {{ 'group.title'|trans }}
				</a>
				<a class="btn btn-primary" href="{{ path('user_new') }}">
					<i class="bi bi-person-plus" aria-hidden="true"></i> {{ 'user.add'|trans }}
				</a>
			</div>
		</div>

		<div class="table-responsive">
			<table class="table align-middle">
				<thead>
					<tr>
						<th scope="col">{{ 'common.name'|trans }}</th>
						<th scope="col">{{ 'common.email'|trans }}</th>
						<th scope="col">{{ 'user.role'|trans }}</th>
						<th scope="col">{{ 'user.last_signed_in'|trans }}</th>
						<th scope="col"><span class="visually-hidden">{{ 'common.actions'|trans }}</span></th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						<tr class="{{ user.active ? '' : 'text-body-secondary' }}">
							<td>
								{{ user.name }}
								{% if user.id == app.user.id %}
									<span class="badge text-bg-light">{{ 'user.you'|trans }}</span>
								{% endif %}
								{% if not user.active %}
									<span class="badge text-bg-secondary">{{ 'user.deactivated'|trans }}</span>
								{% endif %}
								{#
									Two different situations and two different badges (XIV-1).
									"Password not set" means the one you handed them is still in
									use, so it is still a credential two people know. "Invitation
									pending" means there is no password at all — they were sent a
									link and have not chosen one yet, and the link may well have
									expired since.
								#}
								{% if not user.hasPassword %}
									<span class="badge text-bg-light">{{ 'user.invitation_pending'|trans }}</span>
								{% elseif user.mustChangePassword %}
									<span class="badge text-bg-light">{{ 'user.password_not_set'|trans }}</span>
								{% endif %}
							</td>
							<td>{{ user.email }}</td>
							<td>{{ ('ROLE_ADMIN' in user.roles ? 'user.administrator' : 'user.member')|trans }}</td>
							<td>
								{{ user.lastLoginAt ? user.lastLoginAt|date('Y-m-d H:i') : 'user.never'|trans }}
							</td>
							<td class="text-end">
								<div class="d-inline-flex gap-1">
									<a class="btn btn-sm btn-outline-secondary" href="{{ path('user_edit', {id: user.id}) }}"
									   data-bs-toggle="tooltip" title="{{ 'user.tooltip_edit'|trans }}">
										<i class="bi bi-pencil" aria-hidden="true"></i>
										<span class="visually-hidden">{{ 'user.edit_aria'|trans({'%email%': user.email}) }}</span>
									</a>

									{#
										Only where there is an invitation to send again (XIV-1). An
										invitation link signs somebody in without their password, so
										offering one for an account that has chosen a password would
										be offering a way around it — and a deactivated person's link
										would be refused at the door anyway, which is a promise not
										worth making. Reset password is the tool for both of those.

										The 24 hours are why this exists at all: a link that expired
										overnight has to be reissuable without deleting the account.
									#}
									{% if not user.hasPassword and user.active %}
										<form method="post" action="{{ path('user_invite', {id: user.id}) }}">
											<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">
											<button class="btn btn-sm btn-outline-secondary" type="submit"
											        data-bs-toggle="tooltip" title="{{ 'user.tooltip_invite'|trans }}">
												<i class="bi bi-envelope" aria-hidden="true"></i>
												<span class="visually-hidden">{{ 'user.invite_aria'|trans({'%email%': user.email}) }}</span>
											</button>
										</form>
									{% endif %}

									{#
										Left available for somebody awaiting an invitation too, and
										deliberately: it is the way out of an installation whose mail
										is not working. It turns the account into an ordinary one
										with a generated password, which is a change the list then
										shows.
									#}
									<form method="post" action="{{ path('user_password', {id: user.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">
										<button class="btn btn-sm btn-outline-secondary" type="submit"
										        data-bs-toggle="tooltip" title="{{ 'user.tooltip_reset'|trans }}">
											<i class="bi bi-key" aria-hidden="true"></i>
											<span class="visually-hidden">{{ 'user.reset_aria'|trans({'%email%': user.email}) }}</span>
										</button>
									</form>

									{#
										No delete button anywhere on this page. Records carry the id of
										whoever owns them and history carries the id of whoever made each
										change, so a deleted row leaves records belonging to nobody.
										Deactivating locks the person out and keeps all of it readable.
									#}
									<form method="post" action="{{ path('user_active', {id: user.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">
										<input type="hidden" name="active" value="{{ user.active ? '0' : '1' }}">
										<button class="btn btn-sm btn-outline-secondary" type="submit"
										        data-bs-toggle="tooltip"
										        title="{{ (user.active ? 'user.tooltip_deactivate' : 'user.tooltip_reactivate')|trans }}">
											<i class="bi bi-{{ user.active ? 'person-slash' : 'person-check' }}" aria-hidden="true"></i>
											<span class="visually-hidden">
												{{ (user.active ? 'user.deactivate_aria' : 'user.reactivate_aria')|trans({'%email%': user.email}) }}
											</span>
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		{#
			Said on the list rather than only on the groups screen, because the
			question it answers — "why can my new colleague not see anything" —
			is one somebody asks while looking at this page.
		#}
		<p class="text-body-secondary small mb-0">
			{{ 'user.permissions_note'|trans({'%link%': path('group_index')})|raw }}
		</p>
	</main>
{% endblock %}
