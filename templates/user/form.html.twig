{% extends 'base.html.twig' %}

{% block title %}{{ user ? user.email : 'Add user' }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">{{ user ? 'Edit ' ~ user.email : 'Add user' }}</h1>

		<form method="post" class="card">
			<div class="card-body">
				<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">

				<div class="mb-3">
					<label class="form-label" for="email">Email</label>
					<input class="form-control" type="email" id="email" name="email" required
						   value="{{ user ? user.email : (submitted.email ?? '') }}">
					<div class="form-text">This is the login. It has to be unique here, not everywhere.</div>
				</div>

				<div class="mb-3">
					<label class="form-label" for="name">Name</label>
					<input class="form-control" type="text" id="name" name="name"
						   value="{{ user ? user.name : (submitted.name ?? '') }}">
					<div class="form-text">Shown on records they own and in history. Defaults to the email.</div>
				</div>

				<div class="form-check mb-3">
					<input class="form-check-input" type="checkbox" id="admin" name="admin" value="1"
						   {{ user and 'ROLE_ADMIN' in user.roles ? 'checked' : (submitted.admin is defined ? 'checked' : '') }}>
					<label class="form-check-label" for="admin">Administrator</label>
					<div class="form-text">
						Administrators may do everything, and manage users, groups and a module's
						fields. The permissions below have no effect on one.
					</div>
				</div>

				{% if not user %}
					{#
						No password box, on purpose: an administrator who picks a colleague's
						password knows their password. One is generated and shown once (§8.5).
					#}
					<p class="text-body-secondary small mb-3">
						A password is generated when you save, and shown to you once so you can pass it on.
					</p>
				{% endif %}

				<div class="d-flex align-items-center gap-2">
					<button class="btn btn-primary" type="submit">Save</button>
					<a class="btn btn-link" href="{{ path('user_index') }}">Cancel</a>
				</div>
			</div>

			{% if user %}
				<div class="card-body border-top">
					<h2 class="h5 mb-2">Groups</h2>
					<p class="text-body-secondary">
						Where permissions normally come from: a grant made to a job survives the
						person leaving it. <a href="{{ path('group_index') }}">Manage groups</a>.
					</p>

					{% if groups is empty %}
						<p class="text-body-secondary">
							No groups exist yet. <a href="{{ path('group_new') }}">Make one</a>.
						</p>
					{% else %}
						{% for group in groups %}
							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="group-{{ group.id }}"
								       name="groups[{{ group.id }}]" value="{{ group.id }}"
								       {{ group.id in inGroups ? 'checked' : '' }}>
								<label class="form-check-label" for="group-{{ group.id }}">{{ group.label }}</label>
							</div>
						{% endfor %}
					{% endif %}
				</div>

				<div class="card-body border-top">
					<h2 class="h5 mb-2">Extra permissions for this person</h2>
					<p class="text-body-secondary">
						Only for what the groups do not already cover. These <strong>add</strong> to
						what the groups give — nothing here can take a permission away, which is why
						what is already inherited is shown but not editable.
					</p>

					{% if 'ROLE_ADMIN' in user.roles %}
						<div class="alert alert-secondary">
							This person is an administrator and may already do everything. Anything
							set here would take effect only if that were taken away.
						</div>
					{% endif %}

					{% if modules is empty %}
						<div class="alert alert-secondary">No modules are installed, so there is nothing to grant.</div>
					{% else %}
						<div class="table-responsive">
							<table class="table align-middle mb-0">
								<thead>
									<tr>
										<th scope="col" class="text-body-secondary small text-uppercase">Module</th>
										{% for action in actions %}
											<th scope="col" class="text-body-secondary small text-uppercase">{{ action.label }}</th>
										{% endfor %}
									</tr>
								</thead>
								<tbody>
									{% for module in modules %}
										<tr>
											<th scope="row" class="fw-normal">
												<i class="bi bi-{{ module.icon }} text-body-secondary" aria-hidden="true"></i>
												{{ module.label }}
											</th>
											{% for action in actions %}
												{% set current = matrix[module.key][action.value]|default('') %}
												{% set from_group = inherited[module.key][action.value]|default('') %}
												<td>
													{#
														The select shows what this person can actually do — their
														groups and their own grant folded together the way the
														resolver folds them — rather than the difference between the
														two. A control showing "no" beside the words "groups give:
														all" is describing a delta nobody asked about.

														What it cannot do is go below the group's floor, because
														grants only ever add (§8.4). Anything narrower than what the
														groups give is disabled; anything wider is a personal grant,
														and the manager stores only that difference.
													#}
													{% set effective = (from_group == 'all' or current == 'all')
														? 'all'
														: ((from_group == 'own' or current == 'own') ? 'own' : '') %}
													<select class="form-select form-select-sm"
													        name="grants[{{ module.key }}][{{ action.value }}]"
													        aria-label="{{ action.label }} {{ module.label }}">
														<option value="" {{ effective == '' ? 'selected' : '' }}
														        {{ from_group ? 'disabled' : '' }}>No</option>
														{% for scope in scopes %}
															{% if action.isScopable or scope.value == 'all' %}
																{# Strictly narrower than the floor, so unreachable. #}
																<option value="{{ scope.value }}"
																        {{ effective == scope.value ? 'selected' : '' }}
																        {{ from_group == 'all' and scope.value == 'own' ? 'disabled' : '' }}>
																	{{ action.isScopable ? scope.label : 'Yes' }}
																</option>
															{% endif %}
														{% endfor %}
													</select>
													{# Says where the floor comes from, so a disabled option is
													   explained rather than merely refused. #}
													{% if from_group %}
														<div class="form-text mb-0">
															from groups: {{ from_group == 'all' ? 'all' : 'own' }}
														</div>
													{% endif %}
												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>

				<div class="card-body border-top">
					<button class="btn btn-primary" type="submit">Save</button>
					<a class="btn btn-link" href="{{ path('user_index') }}">Cancel</a>
				</div>
			{% endif %}
		</form>
	</main>
{% endblock %}
