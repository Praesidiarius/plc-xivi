{% extends 'base.html.twig' %}

{% block title %}{{ user ? user.email : 'user.add'|trans }}{% endblock %}

{% block body %}
	{{ include('_topbar.html.twig') }}

	<main class="container page-shell">
		{{ include('_flashes.html.twig') }}

		<h1 class="h3 mb-3">{{ user ? 'user.edit_title'|trans({'%email%': user.email}) : 'user.add'|trans }}</h1>

		<form method="post" class="card">
			<div class="card-body">
				<input type="hidden" name="_token" value="{{ csrf_token('manage-users') }}">

				<div class="mb-3">
					<label class="form-label" for="email">{{ 'common.email'|trans }}</label>
					<input class="form-control" type="email" id="email" name="email" required
						   value="{{ user ? user.email : (submitted.email ?? '') }}">
					<div class="form-text">{{ 'user.email_help'|trans }}</div>
				</div>

				<div class="mb-3">
					<label class="form-label" for="name">{{ 'common.name'|trans }}</label>
					<input class="form-control" type="text" id="name" name="name"
						   value="{{ user ? user.name : (submitted.name ?? '') }}">
					<div class="form-text">{{ 'user.name_help'|trans }}</div>
				</div>

				<div class="form-check mb-3">
					<input class="form-check-input" type="checkbox" id="admin" name="admin" value="1"
						   {{ user and 'ROLE_ADMIN' in user.roles ? 'checked' : (submitted.admin is defined ? 'checked' : '') }}>
					<label class="form-check-label" for="admin">{{ 'user.administrator'|trans }}</label>
					<div class="form-text">
						{{ 'user.administrator_help'|trans }}
					</div>
				</div>

				{% if not user %}
					{#
						No password box, on purpose: an administrator who picks a colleague's
						password knows their password. One is generated and shown once (§8.5).
					#}
					<p class="text-body-secondary small mb-3">{{ 'user.generated_password_note'|trans }}</p>
				{% endif %}

				<div class="d-flex align-items-center gap-2">
					<button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button>
					<a class="btn btn-link" href="{{ path('user_index') }}">{{ 'common.cancel'|trans }}</a>
				</div>
			</div>

			{% if user %}
				<div class="card-body border-top">
					<h2 class="h5 mb-2">{{ 'user.groups'|trans }}</h2>
					<p class="text-body-secondary">
						{{ 'user.groups_help'|trans({'%link%': path('group_index')})|raw }}
					</p>

					{% if groups is empty %}
						<p class="text-body-secondary">
							{{ 'user.no_groups'|trans({'%link%': path('group_new')})|raw }}
						</p>
					{% else %}
						{% for group in groups %}
							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="group-{{ group.id }}"
								       name="groups[{{ group.id }}]" value="{{ group.id }}"
								       {{ group.id in inGroups ? 'checked' : '' }}>
								<label class="form-check-label" for="group-{{ group.id }}">{{ group.label }}</label>
							</div>
						{% endfor %}
					{% endif %}
				</div>

				<div class="card-body border-top">
					<h2 class="h5 mb-2">{{ 'user.extra_permissions'|trans }}</h2>
					<p class="text-body-secondary">
						{{ 'user.extra_permissions_help'|trans|raw }}
					</p>

					{% if 'ROLE_ADMIN' in user.roles %}
						<div class="alert alert-secondary">
							{{ 'user.admin_permissions_note'|trans }}
						</div>
					{% endif %}

					{% if modules is empty %}
						<div class="alert alert-secondary">{{ 'group.no_modules'|trans }}</div>
					{% else %}
						<div class="table-responsive">
							<table class="table align-middle mb-0">
								<thead>
									<tr>
										<th scope="col" class="text-body-secondary small text-uppercase">{{ 'common.module'|trans }}</th>
										{% for action in actions %}
											<th scope="col" class="text-body-secondary small text-uppercase">{{ action.labelKey|trans({}, 'xivi') }}</th>
										{% endfor %}
									</tr>
								</thead>
								<tbody>
									{% for module in modules %}
										<tr>
											<th scope="row" class="fw-normal">
												<i class="bi bi-{{ module.icon }} text-body-secondary" aria-hidden="true"></i>
												{{ module.label }}
											</th>
											{% for action in actions %}
												{% set current = matrix[module.key][action.value]|default('') %}
												{% set from_group = inherited[module.key][action.value]|default('') %}
												<td>
													{#
														The select shows what this person can actually do — their
														groups and their own grant folded together the way the
														resolver folds them — rather than the difference between the
														two. A control showing "no" beside the words "groups give:
														all" is describing a delta nobody asked about.

														What it cannot do is go below the group's floor, because
														grants only ever add (§8.4). Anything narrower than what the
														groups give is disabled; anything wider is a personal grant,
														and the manager stores only that difference.
													#}
													{% set effective = (from_group == 'all' or current == 'all')
														? 'all'
														: ((from_group == 'own' or current == 'own') ? 'own' : '') %}
													<select class="form-select form-select-sm"
													        name="grants[{{ module.key }}][{{ action.value }}]"
													        aria-label="{{ action.labelKey|trans({}, 'xivi') }} {{ module.label }}">
														<option value="" {{ effective == '' ? 'selected' : '' }}
														        {{ from_group ? 'disabled' : '' }}>{{ 'permission.no'|trans }}</option>
														{% for scope in scopes %}
															{% if action.isScopable or scope.value == 'all' %}
																{# Strictly narrower than the floor, so unreachable. #}
																<option value="{{ scope.value }}"
																        {{ effective == scope.value ? 'selected' : '' }}
																        {{ from_group == 'all' and scope.value == 'own' ? 'disabled' : '' }}>
																	{{ action.isScopable ? scope.labelKey|trans({}, 'xivi') : 'permission.yes'|trans }}
																</option>
															{% endif %}
														{% endfor %}
													</select>
													{# Says where the floor comes from, so a disabled option is
													   explained rather than merely refused. #}
													{% if from_group %}
														<div class="form-text mb-0">
															{{ 'user.from_groups'|trans({'%scope%': ('permission.scope.' ~ from_group)|trans({}, 'xivi')}) }}
														</div>
													{% endif %}
												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>

				<div class="card-body border-top">
					<button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button>
					<a class="btn btn-link" href="{{ path('user_index') }}">{{ 'common.cancel'|trans }}</a>
				</div>
			{% endif %}
		</form>
	</main>
{% endblock %}
