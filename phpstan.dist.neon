parameters:
    level: 8
    paths:
        - src
        # The engine, which is most of the code and was outside the analysis
        # until 2026-08-14 — so "level 8" had been describing the application's
        # wiring while packages/ went unchecked. Same omission the coverage
        # config had.
        - packages
        - tests
    # Not analysed — migrations are generated-shaped files the cs-fixer is also
    # kept out of — but their classes have to be *findable*, because a test may
    # run one on purpose (XIV-109: the catch-up migration is the only part of
    # that change existing customers meet, and a fresh test database has nothing
    # for it to do). Scanning rather than adding to `paths` keeps the analysis
    # boundary exactly where it was.
    scanDirectories:
        - migrations
    treatPhpDocTypesAsCertain: false

    # Lets the Doctrine and Symfony extensions reason about the real container
    # and entity manager instead of guessing.
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php

    ignoreErrors:
        # Called by Symfony through reflection when APP_ENV is validated.
        -
            message: '#Method App\\Kernel::getAllowedEnvs\(\) is unused#'
            path: src/Kernel.php
        # Part of the Flex skeleton's bootstrap; kept as shipped.
        -
            message: '#Call to function method_exists\(\) with .*Dotenv.*bootEnv.* will always evaluate to true#'
            path: tests/bootstrap.php
