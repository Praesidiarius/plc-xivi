# **The deployment's own environment** (XIV-61, §4.8).
#
# Copy to `.env.deploy.<host alias>`, fill it in, and keep it out of git. It is
# installed on the target once with `dep secrets:install <alias>` and is not
# uploaded again by a deploy: a deploy that shipped these every time would put
# them in the shell history of every machine that ever deployed, and would
# overwrite a value somebody rotated on the box.
#
# PlaceholderSecretGuard refuses to boot if either secret is still the value
# committed in `.env`, so a deployment that forgot one fails to start rather than
# starting and encrypting customer data with a key that is in this repository.
#
#   APP_SECRET          openssl rand -hex 32
#   TENANT_SECRET_KEYS  a keyring, not a key: {"<id>": "<32 random bytes, base64>"}
#                       php -r 'echo json_encode(["1" => base64_encode(random_bytes(32))]);'
#
# TENANT_SECRET_KEY_ID names which entry of the keyring new values are written
# with. Rotation is: add a second entry, point the id at it, run
# `tenant:rotate-secrets`, then drop the old entry once that reports nothing
# stale. Both keys work during the changeover, so the job can be interrupted.

APP_SECRET=
TENANT_SECRET_KEYS=
TENANT_SECRET_KEY_ID=1

# The control-plane database. Per-tenant credentials are resolved at runtime from
# the registry, not from here.
#
# **This password is also what provisioning connects with.** `compose.prod.yaml`
# builds TENANT_ADMIN_DSN and DATABASE_URL out of it, so there is one value to
# set and one to rotate. Do not set TENANT_ADMIN_DSN here: `.env` ships it with a
# placeholder password that PlaceholderSecretGuard deliberately does not guard,
# and a deployment that copies that value provisions nobody.
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# **Which hostnames this installation answers to** (§4.3, XIV-93). Tenants are
# <slug>.<domain> and are not listed anywhere: on-demand TLS asks the application
# instead, which is what TlsAskController is for.
XIVI_TRUSTED_DOMAINS=
CONTROL_PLANE_HOST=
CONTROL_PLANE_ALLOWED_IPS=
SIGNUP_HOST=

# Where absolute URLs and mail links point.
DEFAULT_URI=

# Let's Encrypt writes here about expiring certificates.
TLS_CONTACT_EMAIL=

# A hostname this instance certainly serves, asked by the container healthcheck.
# Usually CONTROL_PLANE_HOST.
HEALTHCHECK_HOST=

# **Staging while rehearsing.** Let's Encrypt's production limit is 50 new
# certificates per registered domain per week, and a deploy tested against it
# spends the budget of every real customer. Uncomment for a rehearsal, and take
# it out before the instance serves anybody.
#
# CADDY_ACME_CA_DIRECTIVE=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# **Postgres, sized for the box** (§4.8). Connections scale with tenants times
# concurrency here, because there is a database per tenant and no pooler. The
# defaults in compose.prod.yaml assume the 8 GB target; a smaller box says so.
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=4MB
GOTENBERG_MEM_LIMIT=1g
