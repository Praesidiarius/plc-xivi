# **The deployment's own environment** (XIV-61, §4.8).
#
# Copy to `.env.deploy.<host alias>`, fill it in, and keep it out of git. It is
# installed on the target once with `dep secrets:install <alias>` and is not
# uploaded again by a deploy: a deploy that shipped these every time would put
# them in the shell history of every machine that ever deployed, and would
# overwrite a value somebody rotated on the box.
#
# PlaceholderSecretGuard refuses to boot if either secret is still the value
# committed in `.env`, so a deployment that forgot one fails to start rather than
# starting and encrypting customer data with a key that is in this repository.
#
#   APP_SECRET          openssl rand -hex 32
#   TENANT_SECRET_KEYS  a keyring, not a key: {"<id>": "<32 random bytes, base64>"}
#                       php -r 'echo json_encode(["1" => base64_encode(random_bytes(32))]);'
#
# TENANT_SECRET_KEY_ID names which entry of the keyring new values are written
# with. Rotation is: add a second entry, point the id at it, run
# `tenant:rotate-secrets`, then drop the old entry once that reports nothing
# stale. Both keys work during the changeover, so the job can be interrupted.

APP_SECRET=
TENANT_SECRET_KEYS=
TENANT_SECRET_KEY_ID=1

# The control-plane database. Per-tenant credentials are resolved at runtime from
# the registry, not from here.
#
# **This password is also what provisioning connects with.** `compose.prod.yaml`
# builds TENANT_ADMIN_DSN and DATABASE_URL out of it, so there is one value to
# set and one to rotate. Do not set TENANT_ADMIN_DSN here: `.env` ships it with a
# placeholder password that PlaceholderSecretGuard deliberately does not guard,
# and a deployment that copies that value provisions nobody.
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# **Which hostnames this installation answers to** (§4.3, XIV-93). Tenants are
# <slug>.<domain> and are not listed anywhere: on-demand TLS asks the application
# instead, which is what TlsAskController is for.
XIVI_TRUSTED_DOMAINS=
CONTROL_PLANE_HOST=
CONTROL_PLANE_ALLOWED_IPS=
SIGNUP_HOST=

# Where absolute URLs and mail links point.
DEFAULT_URI=

# **Signup, which is off until SIGNUP_HOST is set** (§8.13, §8.14). Its parent
# domain is where self-service customers live: signup at `signup.example.com`
# puts them at `<slug>.example.com`. It must not equal CONTROL_PLANE_HOST, and
# the application refuses to build a routing table if it does.
#
# XIVI_SIGNUP_SECRET is the `X-Xivi-Signup-Key` the calling site presents. Empty
# refuses everybody, which is the safe failure. Generate one:
#   php -r 'echo bin2hex(random_bytes(32));'
#
# **Setting these is not the whole step.** `signup:provision` has to run on cron,
# or a confirmed signup sits in the intake and the person who made it waits for a
# mail that never comes.
SIGNUP_HOST=
SIGNUP_PAGE=true
XIVI_SIGNUP_SECRET=
XIVI_SIGNUP_PLANS=standard

# **Where mail goes. The default is nowhere.** `null://null` drops everything,
# which is what `.env` commits so that an installation which has not decided
# cannot accidentally send. There is no built-in delivery: signup confirmations,
# invitations and anything else need a real SMTP server named here before they
# leave the building.
# **Check which SMTP ports the host can actually reach before choosing one.**
# Providers commonly block outbound mail ports to stop their address ranges being
# used for spam, and the block is a timeout rather than a refusal, so it presents
# as mail that hangs rather than mail that fails. Measured on the first target
# on 2026-08-20: **25, 465 and 2525 blocked, 587 open.** So `smtps://` on
# 465 could not work there and `smtp://` on 587 with STARTTLS does.
#
#   docker compose ... run --rm --entrypoint php php -r \
#     'var_dump((bool) @fsockopen("mail.example.com", 587, $e, $m, 8));'
#
# **Percent-encode the credentials.** A username that is an email address puts an
# `@` inside the userinfo, and a password can hold `[`, `]`, `/`, `:` or `#`. All
# of them break URL parsing, and `[` in particular makes the parser read what
# follows as an IPv6 literal. `@` is `%40`, `[` is `%5B`, `]` is `%5D`.
MAILER_DSN=null://null
MAILER_SENDER=

# **Set to 1 only if this installation is meant to have no customers yet**, such
# as one waiting for its first self-service signup. `bin/deploy` otherwise stops
# on an empty registry, on the grounds that an installation which has lost its
# registry is indistinguishable from one that never had a customer, and only the
# deployment knows which it is. It does not weaken anything else: a tenant that
# fails to migrate still fails the deploy, and a `--slug` nothing answers to
# still fails.
XIVI_ALLOW_EMPTY_REGISTRY=

# **Which scheduled jobs an outside service watches** (§4.5), as
# `command=url` pairs separated by commas. `bin/console deploy:crontab` lists
# every job this build has and says which are watched.
#
# Empty is the default and it is the state where a stopped job is invisible: the
# jobs behind signup, purchases and support all fail silently, and a customer
# who confirmed a signup simply never hears back. Healthchecks is the
# recommendation because it can be self-hosted (BSD-3-Clause).
#
# Watch all of them or none. A half-watched installation exits 3 from
# `deploy:crontab`, because the jobs nobody is watching are the ones that will
# stop.
#
# XIVI_MONITOR_PINGS=signup:provision=https://hc-ping.com/<uuid>,tenant:support:collect=https://hc-ping.com/<uuid>
XIVI_MONITOR_PINGS=

# Let's Encrypt writes here about expiring certificates.
TLS_CONTACT_EMAIL=

# A hostname this instance certainly serves, asked by the container healthcheck.
# Usually CONTROL_PLANE_HOST.
HEALTHCHECK_HOST=

# **Staging while rehearsing.** Let's Encrypt's production limit is 50 new
# certificates per registered domain per week, and a deploy tested against it
# spends the budget of every real customer. Uncomment for a rehearsal, and take
# it out before the instance serves anybody.
#
# CADDY_ACME_CA_DIRECTIVE=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# **Before public DNS points at the box**, no certificate authority can issue for
# these hostnames at all: validation is an inbound request from the CA, resolved
# over public DNS, so a hosts file on your own machine changes nothing and the
# staging endpoint above is no different. Rehearse with Caddy's own signature
# instead. The certificate is untrusted, and the ask endpoint is still consulted,
# which is the half worth rehearsing. Remove it once DNS resolves.
#
# CADDY_TLS_ISSUER=issuer internal

# **Postgres, sized for the box** (§4.8). Connections scale with tenants times
# concurrency here, because there is a database per tenant and no pooler. The
# defaults in compose.prod.yaml assume the 8 GB target; a smaller box says so.
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=4MB
GOTENBERG_MEM_LIMIT=1g
