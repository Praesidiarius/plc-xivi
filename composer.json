{
    "name": "xivi/app",
    "type": "project",
    "license": "MIT",
    "description": "Xivi 17 — metadata-driven CRM/ERP engine",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "anourvalar/office": "^2.6",
        "brick/math": "^0.19.1",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "maennchen/zipstream-php": "^3.2",
        "openspout/openspout": "^5.10",
        "sensiolabs/gotenberg-bundle": "^1.4",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-live-component": "^3.4",
        "symfony/validator": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "xivi/article": "^1.0",
        "xivi/contact": "^1.0",
        "xivi/core": "^1.0",
        "xivi/invoice": "^1.0",
        "xivi/order": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "process-timeout": 0,
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Mate\\": "mate/src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "test:parallel": "paratest --processes=8 --testsuite=\"Project Test Suite\"",
        "test:browser": "phpunit --testsuite=browser",
        "coverage": "phpunit --coverage-clover coverage/clover.xml --coverage-html coverage/html --coverage-text",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "deptrac": "deptrac analyse --no-progress",
        "cs": "php-cs-fixer check --diff --show-progress=none",
        "cs-fix": "php-cs-fixer fix"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "dama/doctrine-test-bundle": "^8.6",
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.3",
        "symfony/ai-mate": "^0.12.0",
        "symfony/ai-monolog-mate-extension": "^0.12.0",
        "symfony/ai-symfony-mate-extension": "^0.12.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/panther": "^2.4",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "repositories": [
        {
            "name": "xivi-packages",
            "type": "path",
            "url": "packages/*"
        }
    ]
}
