#!/usr/bin/env bash
#
# The full CI suite, run against the same containers you develop in.
#
# GitHub Actions runs this exact script — there is no second list of checks that
# can drift away from this one. If this passes locally it passes there, and you
# find out before pushing rather than after.
#
#   bin/ci                 everything
#   bin/ci --no-build      skip the two production image builds (the slow part)
#   bin/ci --coverage      measure coverage and hold it above the floor
#   bin/ci --no-changelog  allow a branch that adds no changelog entry
#   bin/ci --reclaim       reclaim the test databases and stop, running nothing
#
# A branch whose entire diff is the landing page's copy needs no entry and no
# flag; see CONTENT_ONLY_PATHS below for the decision and how narrow it is.
#
# `--reclaim` exists so that the suite's own error messages have something to
# name (XIV-106). The reclaim is not otherwise worth a flag — every ordinary run
# does it — but a test bootstrap that has just found a half-applied database has
# to be able to say *type this*, and the alternative was a psql incantation
# nobody would type correctly from a stack trace.
#
# **Two branches at once:** make a git worktree. A different directory gets its
# own compose project, its own ports, its own tenant databases and its own dev
# image, all derived from the directory name, so two checkouts run the suite at
# the same time without meeting (XIV-51, XIV-71). Two runs in the *same* checkout
# are refused rather than allowed to interleave. Reach that stack by hand with
# `bin/compose`, never a bare `docker compose` — the latter finds the main
# checkout's (XIV-55).
#
# Coverage is opt-in rather than always on, but not because it is slow: this
# suite spends its time provisioning databases, so Xdebug costs it about seven
# percent. It is opt-in because the report is only wanted when somebody is going
# to read it. CI passes --coverage.
#
# The stack is left running afterwards; nothing here touches your dev tenants.
# The test suite creates and drops its own.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# **Which stack this run acts on** (XIV-51), which is not this script's to define
# any more (XIV-55): the compose project, the ports, the bind mount and the test
# tenant prefix all come from here, so that `bin/compose` and anything else can
# reach the same stack without replicating the derivation. Read it for the why —
# every line of it used to be in this one.
# shellcheck source=lib/stack-env.sh
. bin/lib/stack-env.sh

# **One run per checkout, and it says so.**
#
# Two checkouts are now separate stacks with separate databases and cannot
# disturb each other. Two runs in the *same* checkout still can: they share a
# project, a stack and — since TEST_TOKEN is the same eight numbers both times —
# one set of tenant databases. The failure is not an error but two suites
# quietly dropping each other's tenants, so this refuses instead.
#
# `flock` rather than a pid file: the kernel releases it however the run ends,
# including a kill, so a crash never leaves a lock nobody can explain.
readonly LOCK="${TMPDIR:-/tmp}/xivi-ci-${XIVI_CHECKOUT}.lock"
exec 9>"$LOCK"

if ! flock --nonblock 9; then
	printf 'Another bin/ci is running in this checkout (%s).\n\n' "$(pwd)" >&2
	printf 'Wait for it, or work in a git worktree — a different directory gets\n' >&2
	printf 'its own stack, its own ports and its own tenant databases (XIV-51).\n' >&2
	exit 1
fi

build_prod_image=true
coverage=false
reclaim_only=false

# A ratchet, sitting just under what the suite currently reaches. Raise it when
# the number rises; argue it down out loud if it ever has to come down. Not 100:
# chasing that buys tests written to reach lines rather than to catch anything.
readonly COVERAGE_FLOOR=77


check_changelog=true

for arg in "$@"; do
	case "$arg" in
		--no-build) build_prod_image=false ;;
		--coverage) coverage=true ;;
		--no-changelog) check_changelog=false ;;
		# Nothing is checked, so nothing wants a changelog entry either. Saying
		# so here rather than making the caller type two flags: a mode that
		# refuses to run because the branch it is cleaning up after has no
		# changelog entry yet would be absurd, and it is exactly the state a
		# branch is in when it needs this.
		--reclaim) reclaim_only=true; check_changelog=false ;;
		-h|--help) sed -n '3,30p' "${BASH_SOURCE[0]}" | cut -c 3-; exit 0 ;;
		*) printf 'unknown option: %s\n' "$arg" >&2; exit 64 ;;
	esac
done

if [ -t 1 ]; then
	step() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }
	pass() { printf '\n\033[1;32m%s\033[0m\n' "$1"; }
else
	step() { printf '\n==> %s\n' "$1"; }
	pass() { printf '\n%s\n' "$1"; }
fi

# Checked before the slow work, so forgetting it costs seconds rather than the
# whole suite. It is a real gate rather than a reminder: a changelog nobody is
# made to write is one that is accurate right up until the week it matters.
#
# --no-changelog is the escape hatch for a branch that genuinely changed nothing
# anybody would be told about. It exists on purpose: a check with no way out is
# one that eventually gets deleted rather than answered.
#
# ---
#
# **Content-only branches are exempt, and that is a decision rather than a
# loophole** (XIV-65, docs/architecture.md §8.13).
#
# The landing page has words on it, and words get edited. A comma moved on a
# signup form is not something to write in a file that documents an ERP — the
# entry would say nothing anybody can act on, which is how a changelog becomes
# noise — and the alternative is `--no-changelog`, typed routinely, until it is
# typed on the branch that did need an entry. A gate people skip out of habit
# stops being a gate, and it stops being one quietly.
#
# So the rule is stated here instead, mechanically, and it is narrow on purpose:
#
#   * The exemption is per *branch*, not per file. Every path the branch touches
#     has to be content. One line of PHP and the gate applies exactly as before,
#     which is what keeps "add a translation key" from carrying a feature through.
#   * What counts as content is a **short, explicit list** below, not a rule like
#     "anything under translations/". The application's own catalogue is product
#     text — renaming "Invoice" is a change a customer sees — while the landing
#     page's catalogue exists to be edited by whoever writes the marketing copy,
#     which is why XIV-65 gave it a domain of its own rather than adding keys to
#     `messages`.
#
# A branch that wants an entry anyway simply writes one; nothing here refuses it.
CONTENT_ONLY_PATHS=(
	'translations/landing.*.yaml'
	'packages/control-plane/templates/signup_page.html.twig'
)

# Whether every path given on stdin is in the list above. Empty input is *not*
# content-only: "this branch changed nothing" is a different situation and the
# ordinary message for it is the right one.
only_content() {
	local path seen=false

	while IFS= read -r path; do
		[ -n "$path" ] || continue
		seen=true

		local matched=false
		for pattern in "${CONTENT_ONLY_PATHS[@]}"; do
			# shellcheck disable=SC2053  # the right-hand side is a glob on purpose
			if [[ "$path" == $pattern ]]; then
				matched=true
				break
			fi
		done

		[ "$matched" = true ] || return 1
	done

	[ "$seen" = true ]
}

if [ "$check_changelog" = true ]; then
	step 'The changelog mentions this branch'

	branch=$(git rev-parse --abbrev-ref HEAD)
	base=$(git merge-base HEAD main 2>/dev/null || true)

	# Committed, staged, unstaged and untracked alike — the same three things the
	# CHANGELOG check below looks at, so the two cannot answer about different
	# versions of the branch.
	changed_paths=$( { git diff --name-only "$base" HEAD 2>/dev/null || true
	                   git diff --name-only HEAD 2>/dev/null || true
	                   git ls-files --others --exclude-standard 2>/dev/null || true
	                 } | sort -u )

	if [ "$branch" = 'main' ] || [ -z "$base" ]; then
		printf 'Not on a branch off main; nothing to compare.\n'
	elif printf '%s\n' "$changed_paths" | only_content; then
		printf 'Content only, so no changelog entry is expected:\n'
		printf '%s\n' "$changed_paths" | sed 's/^/    /'
	elif git diff --quiet "$base" HEAD -- CHANGELOG.md && git diff --quiet HEAD -- CHANGELOG.md; then
		printf 'CHANGELOG.md is unchanged on this branch.\n\n' >&2
		printf 'Add an entry under [Unreleased], with the issue number if there is\n' >&2
		printf 'one — see the [XIV-2] style at the bottom of the file. If this branch\n' >&2
		printf 'really has nothing worth telling anybody about, pass --no-changelog.\n\n' >&2
		printf 'A branch that only edits the landing page and its copy is exempt\n' >&2
		printf 'without the flag — see CONTENT_ONLY_PATHS above for what that means\n' >&2
		printf 'and why the exemption is that narrow.\n' >&2
		exit 65
	else
		printf 'CHANGELOG.md has been updated.\n'
	fi

	# The issue number belongs in the branch name too, when there is an issue.
	case "$branch" in
		main|*/*) ;;
		*) printf '\nNote: branch "%s" carries no issue number. The convention is\n' "$branch" >&2
		   printf 'XIV-123/short-name when an issue exists.\n' >&2 ;;
	esac
fi

step 'Starting the stack'

# **Before the `up`, and only here** (XIV-86). The ports are derived from a
# checksum of the directory name into one of a hundred buckets, and two checkouts
# can land in the same one; when they do, Docker refuses an arbitrary published
# port and says nothing about which other checkout took it, while `DATABASE_PORT`
# quietly names that checkout's Postgres. This is the run's only `up`, so one
# call covers the whole script, and it costs a `docker ps` — nothing against a
# suite that spends minutes provisioning databases.
xivi_assert_ports_free || exit 1

# `docker compose` rather than `bin/compose` from here down, and only because the
# fragment is already sourced into this process: the variables are exported, so
# both reach the same stack. The wrapper is for a shell that has not sourced it.
docker compose up -d --wait

# **The test databases earlier runs left, and the volume they were filling**
# (XIV-78).
#
# This is here, third, rather than next to the suite it prepares, for two
# reasons. It needs nothing but the database container, which `up --wait` has
# just made healthy; and if the volume really is full, a run should say so in its
# first ten seconds rather than after two minutes of static analysis.
#
# ---
#
# **Why anything is left to reclaim at all.** A test class's tenant database is
# not dropped when the class finishes: DAMA holds the transaction — and therefore
# a connection — until the process ends, and Postgres will not drop a database
# somebody is connected to (see tests/Support/SharesATenant.php). So every run
# ends with its databases still there, and the next run reclaimed the ones it
# happened to ask for again by slug.
#
# That reclaim is per *worker*, and there is the leak. A database is named
# `tenant<TEST_RUN><TEST_TOKEN>_<slug>`, the token being paratest's worker
# number, and a class does not land on the same worker twice — so a class that
# ran on worker 3 yesterday and worker 5 today leaves two databases, and over
# enough runs each class spreads across all eight. The set saturates at roughly
# classes × workers, which is eight times the size of one run and grows eight
# times faster than the suite does:
#
#     48 classes × 8 workers × ~9 MB   ≈ 3.6 GB     the ceiling
#     48 classes ×             ~9 MB   =  440 MB    one run, 17% of the tmpfs
#
# The tmpfs had been enlarged three times chasing that, which is the wrong number
# to move: 3g is already seven times what a run needs, and no size is above a
# ceiling that multiplies by the worker count. Measured on this branch, four
# consecutive runs from empty went 48 → 92 → 134 → 170 databases, 17% → 29% →
# 43% → 54% of the volume. It fills on the seventh.
#
# **So: reclaim at the start, not at the end.** Same steady state — one run's
# worth — and it survives the case where leftovers are worst, which is a run that
# crashed or was killed before any teardown of its own could run. It is also
# free: `SharesATenant` *deprovisions and re-provisions* whatever it finds under
# its slug, so nothing was ever being reused and there is no warm-start to give
# up. Measured, because that is the one thing here worth being wrong about — a
# run straight after a full reclaim took 23.9s against 23.6s and 24.5s for runs
# that found their databases waiting.
#
# **Terminating first is not a refinement.** The same subsystem breaks a run the
# other way: a Panther web server left behind by an earlier browser suite holds a
# connection to a tenant database it knows nothing about, and everything that
# touches that tenant then fails with "database … is being accessed by other
# users". A reclaim that issued a plain DROP and hoped would trade one confusing
# failure for another, so sessions go first and the DROP is FORCE'd besides —
# belt for the connection that is already there, braces for the client that
# reconnects in between.
#
# The roles go with the databases because they are cluster objects too, and a
# role left behind without its database is the shape of failure this is meant to
# remove: `CREATE ROLE` does not have an IF NOT EXISTS.
#
# By hand, `bin/compose restart database-test` still empties the volume
# completely and instantly — it is a tmpfs — and remains the thing to reach for
# in the middle of a session.
step 'Test databases from earlier runs'

# The disposable server, named once. This step acts on this service and nothing
# else — the dev tenants are on `database`, on disk, and nothing here has any
# business with them. The *next* step does touch `database`, because the suite's
# control-plane databases turn out to live there (XIV-106); it is deliberately a
# separate step with a separate pattern and its own safety argument, rather than
# this one being widened to two servers.
readonly TEST_DB_SERVICE='database-test'

# What this checkout's suite creates on it, as a regular expression rather than
# a LIKE pattern, because `_` is a LIKE wildcard and these names are made of
# them. TEST_RUN is the checkout (XIV-51) and is empty in the main one; the
# digits are the worker, absent on a serial `composer test`.
#
# **What it covers and what it does not.** Every tenant database the suite
# provisions, on this server, for this checkout — and nothing else on it. It says
# nothing about the control-plane databases, which are not named `tenant…` and
# are not even on this server; that is the next step's, and the reason this one
# looked complete for a fortnight while half the problem was somewhere else.
readonly TEST_DB_PATTERN="^tenant${TEST_RUN}[0-9]*_"

# Above this, refuse rather than run. A clean run needs 18% and the reclaim has
# just happened, so 80% is not "nearly full" — it is "something here is not the
# test suite", and continuing produces the failure described below.
readonly TEST_VOLUME_FULL_PERCENT=80

# psql from inside the database container, with the credentials that container
# was configured with. Not `${POSTGRES_USER:-app}` from out here: Compose reads
# .env and the process environment when it interpolates, and this shell reads
# only the latter, so the two can disagree about who the superuser is. Asking
# the container cannot.
test_psql() {
	docker compose exec -T "$TEST_DB_SERVICE" \
		sh -c 'exec psql -qXtA -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1 "$@"' -- "$@"
}

# **Assert that this is the throwaway server before dropping anything on it.**
# `fsync=off` is set in compose.override.yaml precisely because this data is
# disposable, so it is the closest thing to a machine-readable statement of that
# — and a far better gate than trusting a service name to still mean what it
# means today. If somebody ever points DATABASE_URL at a server that keeps its
# promises, this stops instead of emptying it.
if [ "$(test_psql -c 'SHOW fsync')" != 'off' ]; then
	printf 'Refusing to reclaim test databases: %s is not the throwaway server.\n\n' "$TEST_DB_SERVICE" >&2
	printf 'It reports fsync=on, which compose.override.yaml turns off for the test\n' >&2
	printf 'database precisely because everything on it is disposable. A server that\n' >&2
	printf 'keeps its promises is one whose databases somebody wants.\n' >&2
	exit 66
fi

reclaim_started=$(date +%s%N)
reclaimed=$(test_psql -c "
	SELECT count(*) || ' databases, ' || pg_size_pretty(coalesce(sum(pg_database_size(datname)), 0))
	FROM pg_database WHERE datname ~ '${TEST_DB_PATTERN}'
")

# Output to /dev/null rather than -q: the two SELECTs below are not reports, they
# are \gexec's input — psql runs each row of the result as a statement, which is
# how you write a loop in a client that has none. Errors still reach stderr, and
# ON_ERROR_STOP still fails the script.
docker compose exec -T "$TEST_DB_SERVICE" \
	sh -c 'exec psql -qX -o /dev/null -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1' <<-SQL
	SELECT pg_terminate_backend(pid)
	  FROM pg_stat_activity
	 WHERE datname ~ '${TEST_DB_PATTERN}' AND pid <> pg_backend_pid();

	SELECT format('DROP DATABASE IF EXISTS %I WITH (FORCE)', datname)
	  FROM pg_database WHERE datname ~ '${TEST_DB_PATTERN}';
	\gexec

	SELECT format('DROP ROLE IF EXISTS %I', rolname)
	  FROM pg_roles WHERE rolname ~ '${TEST_DB_PATTERN}';
	\gexec
SQL

reclaim_ms=$((($(date +%s%N) - reclaim_started) / 1000000))

case "$reclaimed" in
	'0 databases'*) printf '    nothing to reclaim (%sms)\n' "$reclaim_ms" ;;
	*)              printf '    reclaimed %s in %sms\n' "$reclaimed" "$reclaim_ms" ;;
esac

# And what that leaves, every run, whether or not it is a problem — the number
# this whole arrangement is justified by should be visible while it is still
# boring. One `df`, in the container, on the mount compose.override.yaml declares.
volume=$(docker compose exec -T "$TEST_DB_SERVICE" df -h /var/lib/postgresql/data | tail -n 1)
volume_used=$(printf '%s' "$volume" | awk '{ print $3 }')
volume_size=$(printf '%s' "$volume" | awk '{ print $2 }')
volume_percent=$(printf '%s' "$volume" | awk '{ print $5 }' | tr -d '%')

printf '    volume %s of %s used (%s%%)\n' "$volume_used" "$volume_size" "$volume_percent"

# **The one line that replaces twenty minutes.** A full test volume does not
# report itself as a full test volume: Postgres aborts its checkpointer, the
# server restarts, and a hundred tests fail with "no connection to the server",
# which reads like anything except a disk. compose.override.yaml has predicted
# that presentation for three enlargements running; this acts on it.
if [ "$volume_percent" -ge "$TEST_VOLUME_FULL_PERCENT" ]; then
	printf '\nThe test database volume is %s%% full, and the reclaim above has already run.\n\n' "$volume_percent" >&2
	printf '    %s\n\n' "$volume" >&2
	printf 'Stopping here on purpose. A full volume does not fail as a full volume:\n' >&2
	printf 'Postgres aborts its checkpointer, restarts, and a hundred tests report\n' >&2
	printf '"no connection to the server" or "could not extend file", which reads\n' >&2
	printf 'like anything except a disk (XIV-78).\n\n' >&2
	printf 'Everything matching this checkout has just been dropped, so what is\n' >&2
	printf 'still on there belongs to something else. `bin/compose restart %s`\n' "$TEST_DB_SERVICE" >&2
	printf 'empties it completely — it is a tmpfs — and if that does not help,\n' >&2
	printf 'something other than this suite is writing to it.\n' >&2
	exit 66
fi

# **The suite's *control-plane* databases, which are not on the test server at
# all** (XIV-106).
#
# The step above reclaims tenant databases on `database-test` and stopped there,
# and for a fortnight that read as the whole job. It is not. `.env.test` points
# `DATABASE_URL` at `database-test` like everything else, and it never takes
# effect: `compose.yaml` sets `DATABASE_URL` in the php container's *environment*,
# a real environment variable outranks anything Dotenv loads, and so the suite's
# control plane is on `database` — the persistent, on-disk server — while its
# tenants are on the tmpfs one. `docs/architecture.md` §9.2 recorded that as a
# curiosity of XIV-78 and left it alone, because these databases are small and
# were no part of the disk problem that ticket was about.
#
# They are a different problem, and it costs a person an afternoon rather than a
# volume.
#
# **What goes wrong.** `tests/bootstrap.php` creates this database if it is
# missing and runs the control migrations into it. Nothing ever drops it, so it
# survives across branches — including the branch that *adds* a control migration
# and then renames or amends it, which is what iterating on a migration looks
# like. `doctrine_migration_versions` is then a record of a tree that no longer
# exists, in one of two shapes:
#
#   * a row naming a class the branch has since renamed, so Doctrine reports it
#     as executed-but-unavailable; or, worse,
#   * no row for the new name, so Doctrine runs a `CREATE TABLE` against the
#     table the old name already created.
#
# The second one is the expensive one, because it does not present as a migration
# problem at all. It is a driver exception — `relation "…" already exists` —
# thrown out of the PHPUnit bootstrap, before a single test has run, on a branch
# whose actual diff is fine. It cost another run two manual `DROP DATABASE`s
# before anybody worked out what they were looking at.
#
# **So it is reclaimed, on the way in, exactly like the tenant databases.**
# `tests/bootstrap.php` is already `create --if-not-exists` followed by
# `migrate`, so an empty database is a state it knows how to be handed; emptying
# one costs it 200 ms more than finding it ready (613 ms against 468 ms,
# measured), and buys the property that no run can inherit another branch's idea
# of what has been applied.
#
# **Unconditionally, rather than only when the versions disagree with the files.**
# The cheap check is tempting and it is not enough. A *renamed* migration leaves
# a recorded version with no file and would be caught by it; an *amended* one —
# same version, different SQL, which is the other half of iterating — leaves the
# version recorded and the migration a no-op, so the check would pass and the
# suite would run against the schema the old SQL built. That failure is quieter
# than the one this ticket is about, and a reclaim that has to be reasoned about
# before it is trusted is not worth having.
#
# **The schema is emptied, not the database dropped, and the difference is
# fifteen seconds a run.** `DROP DATABASE` forces an immediate checkpoint, so on
# this on-disk server it costs about 1.7s each: nine of them measured at 15.4s,
# against 1.7s for `DROP SCHEMA public CASCADE` and 0.2s when the whole list goes
# through one `psql` session. The outcome is identical — `public` is where every
# table these migrations create lives, `doctrine_migration_versions` included, and
# `create --if-not-exists` is a no-op on the database that is left standing. Nine
# empty databases accumulating in `pg_database` is the price, and it is bounded at
# nine.
#
# ---
#
# **The care this needs, and it is not the same care as above.** The step above
# can prove it is pointed at a disposable server by asking it (`SHOW fsync`).
# This one cannot: `database` is emphatically not disposable — the dev tenants
# and the dev control plane are on it — so the safety has to come from the
# *names* instead, and a name is exactly the thing that cannot be trusted here.
# `app_test` looks like a test database and is one today. It would be a
# perfectly ordinary **dev** control plane in a checkout whose `POSTGRES_DB` is
# `app_test`, because `compose.yaml` interpolates that straight into
# `DATABASE_URL`, and there is nothing in the name to tell the two apart. Both
# have the same seven tables; that was checked rather than assumed.
#
# What does tell them apart is the running configuration, so that is what is
# asked. The dev control plane is whatever `DATABASE_URL` in the php container
# names, and the test ones are that name plus the suffix Doctrine appends under
# `when@test` (`config/packages/doctrine.yaml`: `_test%env(default::TEST_TOKEN)%`).
# Deriving the pattern from the base name rather than writing `app_test` down
# makes the dev database structurally unable to match it — `app` is not
# `app_test<digits>`, and in the awkward checkout `app_test` is not
# `app_test_test<digits>` either.
#
# That is the argument. It is not enough on its own, because an argument is what
# gets edited later, so the name is *also* excluded by hand in every statement
# below — `AND datname <> '<the dev one>'`, belt for the derivation and braces
# for whoever one day replaces it with a literal.
#
# **What this deliberately does not cover.**
#
#   * Databases belonging to another checkout. Unlike the tenant names, these
#     carry no `TEST_RUN`: Doctrine's suffix is the worker and nothing else, so
#     every checkout's control-plane test databases have identical names. That is
#     harmless only because each checkout has its own `database` container, which
#     is the same thing `compose.override.yaml` already says about `TEST_RUN`.
#     Point two checkouts at one server and this step drops the neighbour's.
#   * Tenant databases on this server. There are none — the suite's tenants are
#     on `database-test` — and the dev ones (`tenant_acme` and friends) are
#     somebody's working state and are matched by nothing here.
#   * A control plane left behind under a *different* base name, from a checkout
#     that has since changed `POSTGRES_DB`. Nothing knows that name any more, so
#     nothing can reclaim it; it shows up as a stray database in Adminer and is
#     dropped by hand.
step 'Control-plane test databases from earlier runs'

# The persistent server. Named once, for the same reason the other one is.
readonly CONTROL_DB_SERVICE='database'

# psql on it, with that container's own credentials — the same reasoning as
# `test_psql` above, and worth not sharing a function with it: these two act on
# different servers and one of them holds data somebody wants.
control_psql() {
	docker compose exec -T "$CONTROL_DB_SERVICE" \
		sh -c 'exec psql -qXtA -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1 "$@"' -- "$@"
}

# **The dev control plane's name, asked of the container that will serve it.**
#
# Not `${POSTGRES_DB:-app}` from out here. Compose interpolates `.env` and the
# process environment when it builds that variable and this shell reads only the
# latter, so the two can disagree — the identical trap `test_psql` above avoids
# by asking the container who its superuser is. The php container's environment
# is the single thing Symfony will actually read in the dev environment, so it is
# the single thing worth asking.
control_dev_db=$(docker compose exec -T php sh -c 'printf %s "${DATABASE_URL:-}"')
control_dev_db="${control_dev_db%%\?*}"   # drop ?serverVersion=…&charset=…
control_dev_db="${control_dev_db##*/}"    # and everything up to the last slash

# **And then refuse to guess.** A database name is about to be pasted into a
# regular expression and into an SQL literal, and this is the one place where
# being clever about quoting would be worse than being narrow: every name this
# project has ever used is a bare lowercase identifier, so anything else means
# the derivation above has misread something and the honest answer is to stop.
if ! printf '%s' "$control_dev_db" | grep -Eq '^[A-Za-z0-9_]+$'; then
	printf 'Cannot tell which database is the control plane.\n\n' >&2
	printf 'DATABASE_URL in the php container gave %s, which is not a plain\n' "${control_dev_db:-<empty>}" >&2
	printf 'identifier. Refusing to reclaim anything on %s rather than guess at a\n' "$CONTROL_DB_SERVICE" >&2
	printf 'pattern — the dev control plane and the dev tenants are on that server.\n' >&2
	exit 66
fi

# The suffix is Doctrine's, under `when@test`; the digits are paratest's worker
# and are absent on a serial `composer test`, which is why `app_test` itself is
# in the set. Anchored at both ends, unlike the tenant pattern above, because
# these names have nothing after the worker number and a trailing anchor is one
# more thing an accident would have to get past.
readonly CONTROL_TEST_DB_PATTERN="^${control_dev_db}_test[0-9]*\$"

# The assertion the paragraph above promised. It cannot fire while the pattern is
# derived from `$control_dev_db` — that is the point of deriving it — and it is
# here for the edit that replaces the derivation with a literal, which is the
# shape this mistake will actually take.
if printf '%s' "$control_dev_db" | grep -Eq "$CONTROL_TEST_DB_PATTERN"; then
	printf 'Refusing to reclaim: the pattern %s matches the dev control plane\n' "$CONTROL_TEST_DB_PATTERN" >&2
	printf 'itself (%s). Whatever changed above, it has stopped being derived from\n' "$control_dev_db" >&2
	printf 'the database name and has started overlapping it.\n' >&2
	exit 66
fi

control_reclaim_started=$(date +%s%N)

printf '    pattern %s, keeping %s\n' "$CONTROL_TEST_DB_PATTERN" "$control_dev_db"

# The list, on the host, because the emptying below is one statement *per*
# database and SQL has no way to change database mid-script. Every name in it has
# just been matched by a pattern built out of `[A-Za-z0-9_]`, so there is nothing
# here that needs quoting when it goes back down in a moment.
control_test_dbs=$(control_psql -c "
	SELECT datname
	  FROM pg_database
	 WHERE datname ~ '${CONTROL_TEST_DB_PATTERN}' AND datname <> '${control_dev_db}'
	 ORDER BY datname
")

if [ -z "$control_test_dbs" ]; then
	printf '    nothing to reclaim (%sms)\n' "$((($(date +%s%N) - control_reclaim_started) / 1000000))"
else
	# **Sessions first, for the reason the tenant reclaim gives at length**, and
	# with one difference: `DROP SCHEMA` does not need exclusive use of the
	# database the way `DROP DATABASE` does, so an idle connection left by an
	# earlier run is harmless here. What is not harmless is one left *in a
	# transaction* — a killed paratest worker, a Panther server — because that
	# holds locks on the very tables being dropped, and the reclaim would wait
	# behind it rather than fail. `lock_timeout` below is the second half of that:
	# a run that cannot get the lock in five seconds says so instead of hanging,
	# which is the failure mode this whole ticket exists to stop repeating.
	control_psql -o /dev/null -c "
		SELECT pg_terminate_backend(pid)
		  FROM pg_stat_activity
		 WHERE datname ~ '${CONTROL_TEST_DB_PATTERN}'
		   AND datname <> '${control_dev_db}'
		   AND pid <> pg_backend_pid()
	"

	# One `psql` session walking the list with `\connect`, rather than one
	# `docker compose exec` per database. Measured: 0.2s against 1.7s, which is
	# almost entirely the exec overhead — nine round trips through Docker for
	# nine statements that each take a couple of milliseconds.
	#
	# `client_min_messages` because `DROP SCHEMA … CASCADE` narrates every object
	# it removes, and seven tables times nine databases is sixty lines of notice
	# in the middle of a step whose interesting output is one line.
	control_reclaim_script=''
	control_reclaimed=0

	for control_test_db in $control_test_dbs; do
		control_reclaim_script="${control_reclaim_script}\\connect ${control_test_db}
SET client_min_messages = warning;
SET lock_timeout = '5s';
DROP SCHEMA IF EXISTS public CASCADE;
CREATE SCHEMA public;
"
		control_reclaimed=$((control_reclaimed + 1))
	done

	printf '%s' "$control_reclaim_script" | docker compose exec -T "$CONTROL_DB_SERVICE" \
		sh -c 'exec psql -qX -o /dev/null -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1'

	control_reclaim_ms=$((($(date +%s%N) - control_reclaim_started) / 1000000))

	if [ "$control_reclaimed" -eq 1 ]; then
		printf '    emptied 1 database in %sms; the bootstrap migrates it from scratch\n' "$control_reclaim_ms"
	else
		printf '    emptied %s databases in %sms; the bootstrap migrates them from scratch\n' \
			"$control_reclaimed" "$control_reclaim_ms"
	fi
fi

if [ "$reclaim_only" = true ]; then
	pass 'Reclaimed. Nothing else was run.'
	exit 0
fi

step 'composer.json is valid and composer.lock matches it'
docker compose exec -T php composer validate --strict

# **The stack is warm, which means it believes things** (XIV-63). `up --wait`
# above is a no-op on a running stack, so vendor/ is whatever the last install
# left and the compiled service container is whatever the last boot compiled —
# from the tree as it was then. Every check below reads one of those: cs-fixer,
# deptrac and PHPStan are binaries *in* vendor/, and PHPStan reads the dumped
# container XML directly. Analysing this tree against yesterday's artifacts
# produced two afternoons' worth of PHPStan errors that looked like code defects
# and were not.
#
# So this comes before them, and after `validate`: install works from the lock
# file, and the one check that can tell you the lock itself is out of date has
# just run. The timing is printed because "reconciling is cheap" is the claim
# the whole arrangement rests on — if this line ever stops reading as one or two
# seconds on a warm run, the arrangement needs revisiting rather than tolerating.
step 'The stack matches this tree'
reconcile_started=$(date +%s)
docker compose exec -T php bin/reconcile
printf '    %ss\n' "$(($(date +%s) - reconcile_started))"

step 'Dependencies have no known vulnerabilities'
docker compose exec -T php composer audit

step 'Formatting and the licence header (PHP CS Fixer)'
# Symfony's ruleset, minus three rules that fight choices this codebase already
# made — see .php-cs-fixer.dist.php. `composer cs-fix` writes the fixes.
docker compose exec -T php composer cs

step 'Module boundaries (deptrac)'
docker compose exec -T php composer deptrac

step 'Static analysis (PHPStan, level 8)'
docker compose exec -T php composer phpstan

if [ "$coverage" = true ]; then
	step 'Tests with coverage (PHPUnit, serial)'
	# Serial, and not by choice: paratest 7.24 crashes outright when asked for
	# coverage under PHPUnit 13 ("Call to a member function write() on array" in
	# its SuiteLoader). So the coverage run — which is the one GitHub Actions
	# makes — is the serial one until paratest catches up. Worth retrying on the
	# next paratest release; it is the difference between ~48s and ~10s.
	#
	# The tmpfs test database (XIV-10) helps here regardless, and is most of the
	# win: this path was 165s before it.
	#
	# Xdebug is in the dev image already and is the only driver here. The report
	# goes to coverage/ rather than var/, because var/ is an anonymous volume and
	# anything written there cannot be read from the host — which is exactly what
	# CI has to do to upload it.
	rm -rf coverage
	docker compose exec -T -e XDEBUG_MODE=coverage php composer coverage

	step "Coverage is at or above ${COVERAGE_FLOOR}%"
	# The gate runs in the container like everything else — there is no host PHP
	# here. Where its output goes is this script's business, not its own: on
	# GitHub the same text lands on the job page, so a drop is readable without
	# opening the log.
	gate=0
	report=$(docker compose exec -T php php bin/coverage-gate coverage/clover.xml "$COVERAGE_FLOOR" 2>&1) || gate=$?
	printf '%s\n' "$report"

	if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
		printf '### Coverage\n\n```\n%s\n```\n' "$report" >> "$GITHUB_STEP_SUMMARY"
	fi

	[ "$gate" -eq 0 ] || exit "$gate"
else
	step 'Tests (PHPUnit, in parallel)'
	# Eight workers rather than one per core, deliberately: past about four there
	# is no gain, because the wall clock is bounded by the slowest single class
	# and by Postgres serialising CREATE DATABASE. Measured 2026-08-15 — 165s
	# serial, ~85s at four processes, the same at eight and at sixteen.
	#
	# Pinned rather than "auto" for a second reason: each worker namespaces the
	# tenant databases it creates, so changing the number strands the ones the
	# last count left behind. A fixed number means every run reclaims its own.
	docker compose exec -T php composer test:parallel
fi

# A real browser, three assertions, and the only thing in this repository that
# can tell whether the front end works at all (XIV-31). Separate from the run
# above because Panther starts one web server on one port per process, so it
# cannot go through paratest — and the timing is printed because the budget for
# this layer is a decision rather than something to discover later.
step 'Tests (a real browser)'
browser_started=$(date +%s)
docker compose exec -T php composer test:browser
printf '    %ss\n' "$(($(date +%s) - browser_started))"

if [ "$build_prod_image" = true ]; then
	# The dev image says nothing about whether the production one builds: it
	# installs dev dependencies, so a bundle registered for "all" while its
	# package sits in require-dev only fails here. That has happened once.
	#
	# **Two images since XIV-96**, and both are built here — the internal one
	# first, because the customer-facing one is assembled from its builder stage
	# and would rebuild it anyway. See the second `docker build` below for what
	# the extra one costs and why it is not optional.
	#
	# Per-checkout like the dev image (XIV-71), and for a weaker reason: this tag
	# is written and never read, so two concurrent runs racing on one fixed name
	# only ever meant the loser's tag pointed at the winner's build. Nothing is
	# decided from it — the check is "did the build succeed", which is this
	# command's exit status. But it is the same defect for one expansion, and a
	# name that is only *nearly* meaningless is a poor thing to leave lying about
	# for the first person who decides to run something out of that image.
	step 'Internal image builds (the one with the administration surface)'

	# Composer credentials, if this checkout has any (XIV-99). Passed as a
	# BuildKit secret so the token is available while `composer install` runs and
	# is in no layer and no image history afterwards; the Dockerfile declares the
	# mount `required=false`, so a checkout without the file builds exactly as it
	# did before and nobody has to know this exists.
	#
	# Worth knowing what it is and is not for: it raises the GitHub *API*
	# allowance from 60 requests an hour to 5,000, which composer spends on
	# metadata. It does **not** lift the limit on dist archive downloads — that
	# one is per address, and was measured answering 429 to an authenticated
	# request and an anonymous one alike. The thing that protects this build from
	# GitHub is the cache mount beside it, not this.
	build_secret=()
	if [ -f auth.json ]; then
		build_secret=(--secret id=composer_auth,src=auth.json)
	fi

	docker build --target frankenphp_prod -t "${IMAGES_PREFIX}xivi-prod-check" "${build_secret[@]}" .

	# **And the customer-facing one** (XIV-96, docs/architecture.md §4.4).
	#
	# There are two production images: the internal one above, which contains
	# the administration surface, and this one, which does not. Building only
	# the first would leave the second's *existence* untested — and the way it
	# breaks is not subtle. One `user_checker:` added to the application's
	# `security.yaml` because that is where the other firewall's is, and the
	# container no longer compiles without the package; the branch that did it
	# passes every other check in this script, and the failure surfaces at the
	# next release.
	#
	# `tests/Unit/Deployment/ControlPlaneIsOptionalAtBuildTimeTest.php` catches
	# most of that in a second rather than a minute, by reading the
	# configuration. This catches the rest, because it is the only thing here
	# that actually compiles a container with the package absent — and the stage
	# itself asserts that nothing named Xivi\ControlPlane survives in the
	# sources, the autoloader or the compiled container, so a green build is the
	# check rather than merely the precondition for one.
	#
	# **The cost is small and worth naming.** This stage starts from the
	# finished builder above, so it repeats no `composer install` and no
	# dependency download: what it does is one autoload dump and one cache
	# warm-up, measured at a few seconds against the internal image's minutes.
	# Two images from one repository was chosen over two repositories partly for
	# this reason (§4.4) — a second build is cheap, a second migration history
	# is not.
	step 'Customer-facing image builds (and has no administration surface in it)'
	docker build --target frankenphp_public -t "${IMAGES_PREFIX}xivi-public-check" "${build_secret[@]}" .
fi

pass 'All checks passed.'
