{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	# The outermost of the four upload ceilings (XIV-115, §5.30), and the only one
	# enforced before PHP starts. Generously above the others on purpose: what
	# this refuses is refused with a bare 413 that no part of this application can
	# turn into a sentence, so it is here to stop a body nobody asked for rather
	# than to be the limit anybody meets. The one somebody meets is
	# Xivi\Core\Field\AttachmentLimit, at 10 MB, which names itself when it
	# refuses; frankenphp/conf.d/10-app.ini holds the two in between.
	request_body {
		max_size 16MB
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	# Classic mode, deliberately: no `worker` block.
	#
	# Every request boots the kernel and tears it down again, so no PHP state can
	# survive from one tenant's request into the next one's. That makes the
	# docs/architecture/open-questions.md §7.4 leakage class structurally impossible for web requests, at a
	# cost of a few milliseconds per request that this workload does not notice.
	# It does NOT cover shared caches (APCu, Redis, cache pools) — those are
	# shared under any runtime and still have to be namespaced per tenant.
	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}
	}

	file_server {
		hide *.php
	}
}
